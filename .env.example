# Foireann Open Data API — request a key via https://gmssupport.zendesk.com/hc/en-gb
# (requester must be a Club Administrator on the county executive). Server-only —
# never expose to the browser (do not prefix with PUBLIC_).
FOIREANN_API_KEY=

# New York GAA (men's football/hurling) organisation id
FOIREANN_NY_ORG_ID=04da7170-2660-5472-461b-05cf41f10395

# Season to fetch (first value used; comma-separated allowed). Bump for a new year.
FOIREANN_SEASONS=2026
