---
import sponsorsData from '../data/sponsors.json';
import { CLUB_EMAIL, SOCIAL_LINKS } from '../lib/constants';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '/updates', label: 'Updates' },
  { href: '/matches', label: 'Matches' },
  { href: '/shop', label: 'Shop' },
];

const aboutLinks = [
  { href: '/contact', label: 'Contact' },
  { href: '/history', label: 'Club History' },
];
---

<!-- Quote Bar (CPFC style) -->
<div class="bg-gradient-to-br from-shamrock-950 via-shamrock-900 to-shamrock-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <blockquote class="text-white font-bold text-2xl md:text-4xl uppercase tracking-tight leading-tight max-w-3xl">
      "Is ar sc&aacute;th a ch&eacute;ile a mhaireann na daoine"
    </blockquote>
    <p class="text-shamrock-300 text-sm mt-3 uppercase tracking-wide">&mdash; Seanfhocal</p>
  </div>
</div>

<!-- Diagonal separator (CPFC style) -->
<div class="relative h-16 md:h-24 overflow-hidden">
  <div class="absolute inset-0 bg-shamrock-700" style="clip-path: polygon(0 0, 100% 0, 100% 0, 0 100%);"></div>
  <div class="absolute inset-0 bg-gray-900" style="clip-path: polygon(100% 0, 100% 100%, 0 100%);"></div>
</div>

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-3">
          <img src="/images/crest_white_bg.png" alt="Brooklyn Shamrocks" width="48" height="48" class="w-12 h-12 object-contain" />
          <div>
            <span class="font-bold text-lg text-white">Brooklyn Shamrocks</span>
            <span class="block text-xs text-gray-500 uppercase tracking-wider">GAA Club</span>
          </div>
        </a>
        <p class="mt-4 text-sm text-gray-400">
          A GAA-sanctioned club promoting Gaelic football and Irish culture in New York since 1955. New players and transfers welcome.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-bold text-white mb-4 uppercase tracking-wide text-sm">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-shamrock-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- About -->
      <div>
        <h3 class="font-bold text-white mb-4 uppercase tracking-wide text-sm">Club Info</h3>
        <ul class="space-y-2">
          {aboutLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-shamrock-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social & Contact -->
      <div>
        <h3 class="font-bold text-white mb-4 uppercase tracking-wide text-sm">Follow Us</h3>
        <div class="flex gap-4 mb-4">
          <!-- Facebook -->
          <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-shamrock-700 transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-shamrock-700 transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <!-- Twitter/X -->
          <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-shamrock-700 transition-colors" aria-label="X (Twitter)">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
        <p class="text-sm text-gray-400">
          <a href={`mailto:${CLUB_EMAIL}`} class="hover:text-shamrock-400 transition-colors">
            {CLUB_EMAIL}
          </a>
        </p>
      </div>
    </div>

    <!-- Sponsors -->
    <div class="mt-12 pt-8 border-t border-gray-800">
      <p class="text-sm text-gray-500 text-center mb-4">Proudly sponsored by</p>
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
        {sponsorsData.sponsors.map((sponsor) => (
          <a
            href="/sponsors"
            class="text-white font-bold hover:text-shamrock-300 transition-colors"
          >
            {sponsor.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500">
        &copy; {currentYear} Brooklyn Shamrocks GAA. All rights reserved.
      </p>
      <p class="text-sm text-gray-500">
        Member of <a href="https://www.nagaa.org" target="_blank" rel="noopener noreferrer" class="hover:text-shamrock-400 transition-colors">NAGAA</a>
      </p>
    </div>
  </div>
</footer>
