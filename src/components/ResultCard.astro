---
interface Props {
  date: string;
  homeTeam: string;
  awayTeam: string;
  homeScore: string;
  awayScore: string;
  competition: string;
  venue?: string;
  videoUrl?: string;
}

const { date, homeTeam, awayTeam, homeScore, awayScore, competition, venue, videoUrl } = Astro.props;

// Parse the date for display
const dateObj = new Date(date);
const formattedDate = dateObj.toLocaleDateString('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric'
});

// Determine if Shamrocks won, lost, or drew
const shamrocksIsHome = homeTeam === 'Brooklyn Shamrocks';
const shamrocksScore = shamrocksIsHome ? homeScore : awayScore;
const opponentScore = shamrocksIsHome ? awayScore : homeScore;

// Parse GAA scores (e.g., "2-10" = 2 goals + 10 points = 16 total)
function parseGAAScore(score: string): number {
  const parts = score.split('-');
  if (parts.length === 2) {
    return parseInt(parts[0]) * 3 + parseInt(parts[1]);
  }
  return parseInt(score) || 0;
}

const shamrocksTotal = parseGAAScore(shamrocksScore);
const opponentTotal = parseGAAScore(opponentScore);

let result: 'win' | 'loss' | 'draw';
if (shamrocksTotal > opponentTotal) result = 'win';
else if (shamrocksTotal < opponentTotal) result = 'loss';
else result = 'draw';

const resultColors = {
  win: 'bg-green-100 text-green-800 border-green-200',
  loss: 'bg-red-100 text-red-800 border-red-200',
  draw: 'bg-gray-100 text-gray-800 border-gray-200',
};

const resultLabels = {
  win: 'W',
  loss: 'L',
  draw: 'D',
};
---

<article class="card">
  <div class="p-4 md:p-6">
    <!-- Header: Competition & Result Badge -->
    <div class="flex items-center justify-between mb-4">
      <span class="inline-block px-3 py-1 bg-shamrock-100 text-shamrock-700 text-xs font-semibold rounded-full">
        {competition}
      </span>
      <span class={`inline-block px-2 py-1 text-xs font-bold rounded border ${resultColors[result]}`}>
        {resultLabels[result]}
      </span>
    </div>

    <!-- Scores -->
    <div class="flex items-center justify-between gap-4 mb-4">
      <!-- Home Team -->
      <div class="flex-1 text-center">
        <div class="w-12 h-12 mx-auto mb-2 bg-gray-100 rounded-full flex items-center justify-center overflow-hidden">
          {homeTeam === 'Brooklyn Shamrocks' ? (
            <img src="/images/crest_white_bg.png" alt="Brooklyn Shamrocks" width="40" height="40" loading="lazy" class="w-10 h-10 object-contain" />
          ) : (
            <span class="text-gray-400 font-bold text-sm">{homeTeam.substring(0, 2).toUpperCase()}</span>
          )}
        </div>
        <p class="font-semibold text-gray-900 text-sm">{homeTeam}</p>
      </div>

      <!-- Score Display -->
      <div class="flex-shrink-0 text-center">
        <div class="flex items-center gap-2">
          <span class={`text-2xl md:text-3xl font-bold ${homeTeam === 'Brooklyn Shamrocks' ? 'text-shamrock-700' : 'text-gray-700'}`}>
            {homeScore}
          </span>
          <span class="text-gray-300 text-xl">-</span>
          <span class={`text-2xl md:text-3xl font-bold ${awayTeam === 'Brooklyn Shamrocks' ? 'text-shamrock-700' : 'text-gray-700'}`}>
            {awayScore}
          </span>
        </div>
        <p class="text-xs text-gray-400 mt-1">Final</p>
      </div>

      <!-- Away Team -->
      <div class="flex-1 text-center">
        <div class="w-12 h-12 mx-auto mb-2 bg-gray-100 rounded-full flex items-center justify-center overflow-hidden">
          {awayTeam === 'Brooklyn Shamrocks' ? (
            <img src="/images/crest_white_bg.png" alt="Brooklyn Shamrocks" width="40" height="40" loading="lazy" class="w-10 h-10 object-contain" />
          ) : (
            <span class="text-gray-400 font-bold text-sm">{awayTeam.substring(0, 2).toUpperCase()}</span>
          )}
        </div>
        <p class="font-semibold text-gray-900 text-sm">{awayTeam}</p>
      </div>
    </div>

    <!-- Date & Venue -->
    <div class="border-t border-gray-100 pt-4 flex items-center justify-center gap-4 text-sm text-gray-500">
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{formattedDate}</span>
      </div>
      {venue && (
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{venue}</span>
        </div>
      )}
    </div>

    <!-- Watch Video Link -->
    {videoUrl && (
      <div class="border-t border-gray-100 pt-3 mt-3">
        <a
          href={videoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-2 px-4 bg-shamrock-600 hover:bg-shamrock-700 text-white text-sm font-medium rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          Watch Full Match
        </a>
      </div>
    )}
  </div>
</article>
