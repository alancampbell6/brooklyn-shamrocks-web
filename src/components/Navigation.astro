---
import { NAV_ITEMS } from '../lib/nav';

const currentPath = Astro.url.pathname;
---

<nav class="hidden md:flex items-center h-full">
  {NAV_ITEMS.map((item, i) => {
    const isActive = currentPath === item.href ||
      (item.href !== '/' && currentPath.startsWith(item.href));

    return (
      <a
        href={item.href}
        class:list={[
          'flex items-center justify-center h-full px-5 lg:px-6 border-r border-shamrock-600/50 transition-colors',
          isActive
            ? 'text-white bg-shamrock-800/60'
            : 'text-shamrock-100 hover:text-white hover:bg-shamrock-800/40',
        ]}
        style="transform: skewX(-25deg);"
      >
        <span class="text-sm font-bold uppercase tracking-wide" style="transform: skewX(25deg);">
          {item.label}
        </span>
      </a>
    );
  })}
</nav>
