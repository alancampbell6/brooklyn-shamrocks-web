---
import { CLUB_NAME } from '../lib/constants';
import teamColors from '../data/teamColors.json';

interface Props {
  date: string;
  time: string;
  homeTeam: string;
  awayTeam: string;
  venue: string;
  competition: string;
}

const { date, time, homeTeam, awayTeam, venue, competition } = Astro.props;

// Parse the date for display
const dateObj = new Date(date + 'T00:00:00');
const dayName = dateObj.toLocaleDateString('en-US', { weekday: 'short' });
const monthDay = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const homeColor = (teamColors as Record<string, string>)[homeTeam] || '#9ca3af';
const awayColor = (teamColors as Record<string, string>)[awayTeam] || '#9ca3af';
---

<article class="card">
  <div class="p-4 md:p-6">
    <!-- Competition Badge -->
    <div class="mb-4">
      <span class="inline-block px-3 py-1 bg-shamrock-100 text-shamrock-700 text-xs font-semibold rounded-full">
        {competition}
      </span>
    </div>

    <!-- Teams -->
    <div class="flex items-center justify-between gap-4 mb-4">
      <!-- Home Team -->
      <div class="flex-1 text-center">
        <div class="w-12 h-12 mx-auto mb-2 rounded-full flex items-center justify-center overflow-hidden" style={homeTeam === CLUB_NAME ? '' : `background-color: ${homeColor}`}>
          {homeTeam === CLUB_NAME ? (
            <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="40" height="40" loading="lazy" class="w-10 h-10 object-contain" />
          ) : (
            <span class="text-white font-bold text-sm">{homeTeam.substring(0, 2).toUpperCase()}</span>
          )}
        </div>
        <p class="font-semibold text-gray-900 text-sm md:text-base">{homeTeam}</p>
      </div>

      <!-- VS -->
      <div class="flex-shrink-0">
        <span class="text-gray-400 font-bold text-lg">vs</span>
      </div>

      <!-- Away Team -->
      <div class="flex-1 text-center">
        <div class="w-12 h-12 mx-auto mb-2 rounded-full flex items-center justify-center overflow-hidden" style={awayTeam === CLUB_NAME ? '' : `background-color: ${awayColor}`}>
          {awayTeam === CLUB_NAME ? (
            <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="40" height="40" loading="lazy" class="w-10 h-10 object-contain" />
          ) : (
            <span class="text-white font-bold text-sm">{awayTeam.substring(0, 2).toUpperCase()}</span>
          )}
        </div>
        <p class="font-semibold text-gray-900 text-sm md:text-base">{awayTeam}</p>
      </div>
    </div>

    <!-- Date, Time & Venue -->
    <div class="border-t border-gray-100 pt-4 space-y-2">
      <div class="flex items-center justify-center gap-4 text-sm">
        <div class="flex items-center gap-1.5 text-gray-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>{dayName}, {monthDay}</span>
        </div>
        <div class="flex items-center gap-1.5 text-gray-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{time}</span>
        </div>
      </div>
      <div class="flex items-center justify-center gap-1.5 text-sm text-gray-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{venue}</span>
      </div>
    </div>
  </div>
</article>
