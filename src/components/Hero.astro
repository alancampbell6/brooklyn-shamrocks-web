---
interface Props {
  title: string;
  subtitle?: string;
  showCta?: boolean;
  size?: 'small' | 'medium' | 'large';
}

const { title, subtitle, showCta = false, size = 'large' } = Astro.props;

const sizeClasses = {
  small: 'py-12 md:py-16',
  medium: 'py-16 md:py-24',
  large: 'py-20 md:py-32',
};
---

<section class={`relative overflow-hidden ${sizeClasses[size]}`}>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <picture>
      <source srcset="/images/hero-team-huddle.webp" type="image/webp" />
      <img src="/images/hero-team-huddle.jpg" alt="" class="w-full h-full object-cover" fetchpriority="high" />
    </picture>
    <div class="absolute inset-0 bg-shamrock-900/75"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Title -->
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
      {title}
    </h1>

    {subtitle && (
      <p class="text-lg md:text-xl text-shamrock-100 max-w-2xl mx-auto mb-8">
        {subtitle}
      </p>
    )}

    {showCta && (
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/matches" class="btn btn-secondary">
          View Matches
        </a>
      </div>
    )}
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg class="w-full h-8 md:h-12 text-white" viewBox="0 0 1440 48" fill="currentColor" preserveAspectRatio="none">
      <path d="M0,48 L1440,48 L1440,0 C1200,32 960,48 720,48 C480,48 240,32 0,0 L0,48 Z"></path>
    </svg>
  </div>
</section>
