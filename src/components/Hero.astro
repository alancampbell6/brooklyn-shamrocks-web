---
interface Props {
  title: string;
  subtitle?: string;
  showCta?: boolean;
  size?: 'small' | 'medium' | 'large';
  bottomColor?: string;
}

const { title, subtitle, showCta = false, size = 'large', bottomColor = 'white' } = Astro.props;

const sizeClasses = {
  small: 'py-12 md:py-16',
  medium: 'py-16 md:py-24',
  large: 'py-20 md:py-32',
};
---

<section class={`relative overflow-hidden ${sizeClasses[size]} bg-shamrock-900`}>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <picture>
      <source srcset="/images/hero-team-huddle.webp" type="image/webp" />
      <img src="/images/hero-team-huddle.jpg" alt="" class="w-full h-full object-cover" fetchpriority="high" />
    </picture>
    <div class="absolute inset-0 bg-shamrock-900/75"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Title -->
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 uppercase tracking-tight">
      {title}
    </h1>

    {subtitle && (
      <p class="text-lg md:text-xl text-shamrock-100 max-w-2xl mx-auto mb-8">
        {subtitle}
      </p>
    )}

    {showCta && (
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/matches" class="btn btn-secondary uppercase tracking-wide">
          View Matches
        </a>
      </div>
    )}
  </div>

  <!-- Diagonal Bottom Cut -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg class="w-full h-10 md:h-16" viewBox="0 0 1440 64" fill="none" preserveAspectRatio="none">
      <polygon points="0,64 1440,64 1440,24 0,64" fill={bottomColor} />
    </svg>
  </div>
</section>
