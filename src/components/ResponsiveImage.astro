---
// <picture> with AVIF + WebP srcsets generated by scripts/responsive-images.mjs.
// Falls back to the original file, and to a plain <img> if no variants exist.
import manifest from '../data/responsive-images.json';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
}

const { src, alt, sizes, class: className, loading = 'lazy', fetchpriority, width, height } = Astro.props;
const entry = (manifest as Record<string, { width: number; height: number; base: string; widths: number[] }>)[src];
const srcset = (fmt: string) => entry?.widths.map((w) => `${entry.base}-${w}.${fmt} ${w}w`).join(', ');
---

<picture>
  {entry && <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />}
  {entry && <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />}
  <img
    src={src}
    alt={alt}
    width={width ?? entry?.width}
    height={height ?? entry?.height}
    class={className}
    loading={loading}
    decoding={loading === 'lazy' ? 'async' : undefined}
    fetchpriority={fetchpriority}
  />
</picture>
