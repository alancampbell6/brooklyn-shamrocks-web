---
import Navigation from './Navigation.astro';
import { NAV_ITEMS } from '../lib/nav';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/crest_white_bg.png" alt="Brooklyn Shamrocks" width="48" height="48" class="w-10 h-10 md:w-12 md:h-12 object-contain" />
        <div class="hidden sm:block">
          <span class="font-bold text-lg md:text-xl text-gray-900 group-hover:text-shamrock-700 transition-colors">
            Brooklyn Shamrocks
          </span>
          <span class="block text-xs text-gray-500 uppercase tracking-wider">GAA Club</span>
        </div>
      </a>

      <!-- Navigation -->
      <Navigation />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white" aria-hidden="true">
    <nav class="px-4 py-4 space-y-2">
      {NAV_ITEMS.map((item) => {
        const isActive = currentPath === item.href ||
          (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'block px-4 py-2 rounded-lg transition-colors',
              isActive
                ? 'bg-shamrock-100 text-shamrock-700 font-semibold'
                : 'text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Show mobile nav when JS is disabled -->
  <noscript>
    <style>#mobile-menu { display: block !important; }</style>
  </noscript>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    menuBtn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
