---
import Navigation from './Navigation.astro';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/crest_white_bg.png" alt="Brooklyn Shamrocks" class="w-10 h-10 md:w-12 md:h-12 object-contain" />
        <div class="hidden sm:block">
          <span class="font-bold text-lg md:text-xl text-gray-900 group-hover:text-shamrock-700 transition-colors">
            Brooklyn Shamrocks
          </span>
          <span class="block text-xs text-gray-500 uppercase tracking-wider">GAA Club</span>
        </div>
      </a>

      <!-- Navigation -->
      <Navigation />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100"
        aria-label="Open menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <nav class="px-4 py-4 space-y-2">
      <a href="/" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">Home</a>
      <a href="/updates" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">Updates</a>
      <a href="/fixtures" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">Fixtures</a>
      <a href="/results" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">Results</a>
      <a href="/teams" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">Teams</a>
      <a href="/history" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">History</a>
      <a href="/shop" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">Shop</a>
      <a href="/about" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">About</a>
      <a href="/contact" class="block px-4 py-2 text-gray-700 hover:bg-shamrock-50 hover:text-shamrock-700 rounded-lg">Contact</a>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
