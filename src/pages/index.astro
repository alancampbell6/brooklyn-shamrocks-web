---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FixtureCard from '../components/FixtureCard.astro';
import ResultCard from '../components/ResultCard.astro';
import SectionHeading from '../components/SectionHeading.astro';

import fixturesData from '../data/fixtures.json';
import resultsData from '../data/results.json';
import videosData from '../data/videos.json';
import sponsorsData from '../data/sponsors.json';
import { CLUB_NAME } from '../lib/constants';

// Helper function to find video URL for a result
function findVideoUrl(result: typeof resultsData.results[0]): string | undefined {
  const opponent = result.homeTeam === CLUB_NAME ? result.awayTeam : result.homeTeam;
  const video = videosData.videos.find(v => {
    const opponentMatch = v.opponent.toLowerCase() === opponent.toLowerCase() ||
                          opponent.toLowerCase().includes(v.opponent.toLowerCase()) ||
                          v.opponent.toLowerCase().includes(opponent.toLowerCase());
    const roundMatch = v.round.toLowerCase() === result.round.toLowerCase();
    return opponentMatch && roundMatch;
  });
  return video?.url;
}

// Compare date strings directly (YYYY-MM-DD sorts lexicographically) to avoid
// timezone off-by-one issues when comparing UTC-parsed dates to local time.
const todayStr = new Date().toLocaleDateString('en-CA'); // en-CA gives YYYY-MM-DD in local time
const upcomingFixtures = fixturesData.fixtures
  .filter(f => f.date >= todayStr)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const nextFixture = upcomingFixtures[0];

// Get the latest result
const latestResultRaw = resultsData.results
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())[0];

const latestResult = latestResultRaw ? {
  ...latestResultRaw,
  videoUrl: findVideoUrl(latestResultRaw)
} : null;

const quickLinks = [
  {
    title: 'Matches',
    description: 'Fixtures & results',
    href: '/matches',
    icon: 'calendar',
  },
  {
    title: 'Club History',
    description: 'Our story and achievements',
    href: '/history',
    icon: 'book',
  },
];
---

<BaseLayout title="Gaelic Football in Brooklyn, NY" description="Brooklyn Shamrocks GAA - New York's oldest Gaelic football club, founded in 1955. Join us for matches, training, and Irish community events in Brooklyn.">
  <!-- Hero Section -->
  <Hero
    title="Brooklyn Shamrocks"
    subtitle="Promoting Gaelic games and Irish culture in Brooklyn, New York. Join us on the field or in the stands."
    showCta={true}
    size="medium"
  />

  <!-- Next Fixture & Latest Result -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Next Fixture -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2 h-2 bg-shamrock-500 rounded-full animate-pulse"></span>
            <h2 class="text-lg font-semibold text-gray-900">Next Fixture</h2>
          </div>
          {nextFixture ? (
            <FixtureCard {...nextFixture} />
          ) : (
            <div class="card p-6 text-center text-gray-500">
              No upcoming fixtures scheduled
            </div>
          )}
          <a href="/matches" class="inline-flex items-center gap-1 mt-4 text-shamrock-700 hover:text-shamrock-800 font-medium text-sm">
            View all fixtures
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Latest Result -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2 h-2 bg-gold-500 rounded-full"></span>
            <h2 class="text-lg font-semibold text-gray-900">Latest Result</h2>
          </div>
          {latestResult ? (
            <ResultCard {...latestResult} />
          ) : (
            <div class="card p-6 text-center text-gray-500">
              No results available
            </div>
          )}
          <a href="/matches" class="inline-flex items-center gap-1 mt-4 text-shamrock-700 hover:text-shamrock-800 font-medium text-sm">
            View all results
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Explore the Club"
        subtitle="Everything you need to know about Brooklyn Shamrocks"
      />

      <div class="grid sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
        {quickLinks.map((link) => (
          <a href={link.href} class="card p-6 group hover:border-shamrock-200 border border-transparent">
            <div class="w-12 h-12 bg-shamrock-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-shamrock-200 transition-colors">
              {link.icon === 'calendar' && (
                <svg class="w-6 h-6 text-shamrock-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              )}
              {link.icon === 'book' && (
                <svg class="w-6 h-6 text-shamrock-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
            </div>
            <h3 class="font-semibold text-gray-900 mb-1 group-hover:text-shamrock-700 transition-colors">
              {link.title}
            </h3>
            <p class="text-sm text-gray-500">{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Teams -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Our Teams"
        subtitle="Two squads competing across New York GAA competitions"
      />
      <div class="grid md:grid-cols-2 gap-6">
        <div class="card p-6 border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Senior Football</h3>
          <p class="text-sm text-gray-600 mb-4">
            Our flagship team competing at the highest level in the NY Senior Football Championship and league competitions throughout the season.
          </p>
          <div class="text-sm text-gray-500 space-y-1">
            <p>Training: Tue & Thu, 7:00 PM</p>
            <p>Randalls Island Field 73</p>
          </div>
        </div>
        <div class="card p-6 border border-gray-100">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Junior Football</h3>
          <p class="text-sm text-gray-600 mb-4">
            A pathway for developing players and those returning to the game, competing in the NY Junior Football Championship with a focus on skill development.
          </p>
          <div class="text-sm text-gray-500 space-y-1">
            <p>Training: Tue & Thu, 7:00 PM</p>
            <p>Randalls Island Field 73</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Club News / Announcements -->
  <section class="py-12 md:py-16 bg-shamrock-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Join the Shamrocks Family
      </h2>
      <p class="text-shamrock-100 max-w-2xl mx-auto mb-8">
        Whether you're an experienced player or new to Gaelic games, we welcome all levels.
        Training sessions, social events, and a community that feels like family.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn btn-secondary">
          Become a Member
        </a>
        <a href="/contact" class="btn border-2 border-white text-white hover:bg-white hover:text-shamrock-900">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Upcoming Fixtures Preview -->
  {upcomingFixtures.length > 1 && (
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeading
          title="Upcoming Fixtures"
          subtitle="Catch our teams in action"
        />

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {upcomingFixtures.slice(0, 3).map((fixture) => (
            <FixtureCard {...fixture} />
          ))}
        </div>

        <div class="text-center mt-8">
          <a href="/matches" class="btn btn-outline">
            View Full Schedule
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Sponsors Section -->
  <section class="py-12 md:py-16 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Our Sponsors</h2>
        <p class="text-gray-600">Proudly supported by our generous sponsors</p>
      </div>

      <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16">
        {sponsorsData.sponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group flex flex-col items-center p-6 rounded-xl transition-all hover:shadow-lg bg-white",
              sponsor.tier === 'primary' ? 'shadow-md' : ''
            ]}
          >
            <div class:list={[
              "flex items-center justify-center mb-4",
              sponsor.tier === 'primary' ? 'h-28' : 'h-20'
            ]}>
              <picture>
                <source srcset={sponsor.logo.replace('.png', '.webp')} type="image/webp" />
                <img
                  src={sponsor.logo}
                  alt={sponsor.name}
                  loading="lazy"
                  class:list={[
                    "max-h-full w-auto object-contain group-hover:scale-105 transition-transform",
                    sponsor.tier === 'primary' ? 'max-w-64' : 'max-w-48'
                  ]}
                />
              </picture>
            </div>
            <span class:list={[
              "text-sm font-medium",
              sponsor.tier === 'primary' ? 'text-gold-600' : 'text-gray-500'
            ]}>
              {sponsor.description}
            </span>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <p class="text-sm text-gray-500 mb-4">
          Interested in sponsoring Brooklyn Shamrocks?
        </p>
        <a href="/contact" class="text-shamrock-700 hover:text-shamrock-800 font-medium text-sm inline-flex items-center gap-1">
          Get in touch
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
