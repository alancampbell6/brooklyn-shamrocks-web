---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FixtureCard from '../components/FixtureCard.astro';
import ResultCard from '../components/ResultCard.astro';
import SectionHeading from '../components/SectionHeading.astro';

import fixturesData from '../data/fixtures.json';
import resultsData from '../data/results.json';
import videosData from '../data/videos.json';
import productsData from '../data/products.json';
import sponsorsData from '../data/sponsors.json';
import teamsData from '../data/teams.json';
import { CLUB_NAME, SOCIAL_LINKS } from '../lib/constants';
import { findVideoUrl } from '../lib/gaa';

// Compare date strings directly (YYYY-MM-DD sorts lexicographically) to avoid
// timezone off-by-one issues when comparing UTC-parsed dates to local time.
const todayStr = new Date().toLocaleDateString('en-CA');
const upcomingFixtures = fixturesData.fixtures
  .filter(f => f.date >= todayStr)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const nextFixture = upcomingFixtures[0];

// Get the latest result (spread to avoid mutating the imported array)
const latestResultRaw = [...resultsData.results]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())[0];

const latestResult = latestResultRaw ? {
  ...latestResultRaw,
  videoUrl: findVideoUrl(latestResultRaw, videosData.videos)
} : null;

// Featured products for shop carousel
const featuredProducts = productsData.products.filter(p => p.featured);

// Social/updates cards
const updateCards = [
  {
    title: 'Latest from Facebook',
    description: 'Match day updates, club news, and community events.',
    href: '/updates',
    icon: 'facebook',
    external: false,
  },
  {
    title: 'Follow on Instagram',
    description: 'Behind the scenes, training photos, and match day galleries.',
    href: SOCIAL_LINKS.instagram,
    icon: 'instagram',
    external: true,
  },
  {
    title: 'Follow on X',
    description: 'Live match updates, scores, and breaking club news.',
    href: SOCIAL_LINKS.x,
    icon: 'x',
    external: true,
  },
];
---

<BaseLayout title="Gaelic Football in Brooklyn, NY" description="Brooklyn Shamrocks GAA - a sanctioned New York GAA club founded in 1955. Play Gaelic football in NYC with our junior and senior teams. New players and GAA transfers welcome." preloadHero={true}>
  <!-- Hero Section -->
  <Hero
    title="Brooklyn Shamrocks"
    subtitle="A GAA-sanctioned club promoting Gaelic football and Irish culture in New York. New players and transfers welcome."
    showCta={true}
    size="large"
    bottomColor="#14532d"
  />

  <!-- Match Centre: Next Fixture & Latest Result (CPFC-style sharp cards on dark bg) -->
  <section class="py-10 md:py-14 bg-shamrock-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Last Match -->
        <div>
          <h2 class="text-sm font-bold text-white uppercase tracking-widest mb-4 border-b border-shamrock-700 pb-2">Last Match</h2>
          {latestResult ? (
            <div class="[&_.card]:rounded-none [&_.card]:shadow-none">
              <ResultCard {...latestResult} />
            </div>
          ) : (
            <div class="bg-white p-6 text-center text-gray-500">
              No results available
            </div>
          )}
          <a href="/matches" class="inline-flex items-center gap-2 mt-4 text-sm font-bold text-shamrock-300 hover:text-white uppercase tracking-wide transition-colors">
            View all results
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Next Match -->
        <div>
          <div class="flex items-center gap-2 mb-4 border-b border-shamrock-700 pb-2">
            <h2 class="text-sm font-bold text-white uppercase tracking-widest">Next Match</h2>
            <span class="w-2 h-2 bg-shamrock-400 rounded-full animate-pulse"></span>
          </div>
          {nextFixture ? (
            <div class="[&_.card]:rounded-none [&_.card]:shadow-none">
              <FixtureCard {...nextFixture} />
            </div>
          ) : (
            <div class="bg-white p-6 text-center">
              <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="font-semibold text-gray-700 mb-1">Season fixtures coming soon</p>
              <p class="text-sm text-gray-400">Follow us for schedule updates</p>
              <div class="flex justify-center gap-3 mt-4">
                <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" class="text-shamrock-300 hover:text-white transition-colors" aria-label="Instagram">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
                <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer" class="text-shamrock-300 hover:text-white transition-colors" aria-label="X">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              </div>
            </div>
          )}
          <a href="/matches" class="inline-flex items-center gap-2 mt-4 text-sm font-bold text-shamrock-300 hover:text-white uppercase tracking-wide transition-colors">
            View all fixtures
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Diagonal separator: dark to light -->
  <div class="relative h-10 md:h-16 bg-white">
    <div class="absolute inset-0 bg-shamrock-900" style="clip-path: polygon(0 0, 100% 0, 0 100%);"></div>
  </div>

  <!-- Latest Updates -->
  <section class="py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 uppercase tracking-tight">Latest Updates</h2>
        <a href="/updates" class="inline-flex items-center gap-1 px-5 py-2 bg-shamrock-900 text-white text-sm font-bold uppercase tracking-wide hover:bg-shamrock-800 transition-colors">
          View all
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid sm:grid-cols-3 gap-6">
        {updateCards.map((card) => (
          <a
            href={card.href}
            target={card.external ? '_blank' : undefined}
            rel={card.external ? 'noopener noreferrer' : undefined}
            class="bg-white border border-gray-200 p-6 group hover:shadow-lg transition-shadow"
          >
            <div class="w-12 h-12 bg-shamrock-100 flex items-center justify-center mb-4 group-hover:bg-shamrock-200 transition-colors">
              {card.icon === 'facebook' && (
                <svg class="w-6 h-6 text-shamrock-700" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
              {card.icon === 'instagram' && (
                <svg class="w-6 h-6 text-shamrock-700" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              )}
              {card.icon === 'x' && (
                <svg class="w-6 h-6 text-shamrock-700" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-shamrock-700 transition-colors">
              {card.title}
            </h3>
            <p class="text-sm text-gray-500">{card.description}</p>
            {card.external && (
              <span class="inline-flex items-center gap-1 mt-3 text-xs text-gray-400 uppercase tracking-wide">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                External
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Shop Carousel (CPFC style: sharp edges, bold heading, dark button) -->
  <section class="py-10 md:py-14 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 uppercase tracking-tight">Shop Shamrocks Gear</h2>
        <a href="/shop" class="inline-flex items-center gap-1 px-5 py-2 bg-shamrock-900 text-white text-sm font-bold uppercase tracking-wide hover:bg-shamrock-800 transition-colors">
          View Shop
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="relative">
        <!-- Scroll buttons (sharp rectangle like CPFC) -->
        <button
          id="shop-scroll-left"
          class="hidden md:flex absolute -left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 bg-shamrock-700 items-center justify-center text-white hover:bg-shamrock-600 transition-colors shadow-lg"
          aria-label="Scroll left"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div id="shop-carousel" class="carousel pb-4">
          {featuredProducts.map((product) => (
            <a
              href={product.url}
              target="_blank"
              rel="noopener noreferrer"
              class="carousel-item w-56 md:w-64 group"
            >
              <div class="bg-white overflow-hidden hover:shadow-lg transition-shadow">
                <div class="aspect-square bg-gray-100 overflow-hidden">
                  <img
                    src={product.image}
                    alt={product.name}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-gray-900 line-clamp-2 group-hover:text-shamrock-700 transition-colors">
                    {product.name}
                  </h3>
                  <p class="text-sm font-bold text-shamrock-700 mt-1">{product.price}</p>
                </div>
              </div>
            </a>
          ))}
        </div>

        <button
          id="shop-scroll-right"
          class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 bg-shamrock-700 items-center justify-center text-white hover:bg-shamrock-600 transition-colors shadow-lg"
          aria-label="Scroll right"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Match Highlights (CPFC-style dark section with sharp cards) -->
  <section class="py-10 md:py-14 bg-shamrock-900 relative overflow-hidden">
    <!-- Watermark text (like CPFC's "PALACE TV") -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" aria-hidden="true">
      <span class="text-shamrock-800/30 text-[8rem] md:text-[12rem] font-bold uppercase tracking-tighter leading-none">Shamrocks</span>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-white uppercase tracking-tight">Match Highlights</h2>
        <a href="https://plus.newlogicalsports.com/categories/category-effcuqyezzo" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-5 py-2 bg-shamrock-700 text-white text-sm font-bold uppercase tracking-wide hover:bg-shamrock-600 transition-colors">
          View All
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div id="video-carousel" class="carousel pb-4">
        {videosData.videos.map((video) => (
          <a
            href={video.url}
            target="_blank"
            rel="noopener noreferrer"
            class="carousel-item w-72 md:w-80 group"
          >
            <div class="bg-shamrock-800 overflow-hidden hover:bg-shamrock-700/80 transition-colors">
              <div class="aspect-video bg-shamrock-800 flex items-center justify-center relative">
                <div class="w-14 h-14 rounded-full bg-gold-500/90 flex items-center justify-center group-hover:bg-gold-500 group-hover:scale-110 transition-all">
                  <svg class="w-6 h-6 text-gray-900 ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
                <span class="absolute top-2 right-2 bg-black/60 text-white text-xs px-2 py-0.5 font-semibold">
                  {video.round}
                </span>
              </div>
              <div class="p-4">
                <p class="text-sm font-semibold text-white line-clamp-2 group-hover:text-shamrock-100">
                  {video.title}
                </p>
                <p class="text-xs text-shamrock-400 mt-2 uppercase tracking-wide">vs {video.opponent}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA Section -->
  <section class="py-12 md:py-16 bg-shamrock-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 uppercase tracking-tight">
        Play Gaelic Football in NYC
      </h2>
      <p class="text-shamrock-100 max-w-2xl mx-auto mb-8">
        Whether you're an experienced player or new to Gaelic games, we welcome all levels.
        As a GAA-sanctioned club, we accept transfers from clubs worldwide. Join our junior or senior football teams for training, competitive matches, and a community that feels like family.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn btn-secondary btn-sharp uppercase tracking-wide">
          Become a Member
        </a>
        <a href="/contact" class="btn btn-sharp border-2 border-white text-white hover:bg-white hover:text-shamrock-900 uppercase tracking-wide">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Our Teams -->
  <section class="py-10 md:py-14 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Our Teams"
        subtitle="Junior and senior football squads competing in New York GAA"
      />
      <div class="grid md:grid-cols-2 gap-6">
        {teamsData.teams.map((team) => (
          <div class="bg-white border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-1.5 bg-gradient-to-r from-shamrock-700 to-shamrock-500"></div>
            <div class="p-6 flex gap-4">
              <img src="/images/crest_white_bg.png" alt="" width="48" height="48" loading="lazy" class="w-12 h-12 object-contain flex-shrink-0 opacity-60" />
              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-2 uppercase tracking-wide">{team.name}</h3>
                <p class="text-sm text-gray-600 mb-4">{team.description}</p>
                <div class="text-sm text-gray-500 space-y-1">
                  <p>Training: {team.trainingDays}, {team.trainingTime}</p>
                  <p>{team.trainingLocation}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sponsors Section -->
  <section class="py-10 md:py-14 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2 uppercase tracking-tight">Our Sponsors</h2>
        <p class="text-gray-600">Proudly supported by our generous sponsors</p>
      </div>

      <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16">
        {sponsorsData.sponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group flex flex-col items-center p-6 transition-all hover:shadow-lg bg-white",
              sponsor.tier === 'primary' ? 'shadow-md' : ''
            ]}
          >
            <div class:list={[
              "flex items-center justify-center mb-4",
              sponsor.tier === 'primary' ? 'h-28' : 'h-20'
            ]}>
              <picture>
                <source srcset={sponsor.logo.replace('.png', '.webp')} type="image/webp" />
                <img
                  src={sponsor.logo}
                  alt={sponsor.name}
                  loading="lazy"
                  class:list={[
                    "max-h-full w-auto object-contain group-hover:scale-105 transition-transform",
                    sponsor.tier === 'primary' ? 'max-w-64' : 'max-w-48'
                  ]}
                />
              </picture>
            </div>
            <span class:list={[
              "text-sm font-semibold",
              sponsor.tier === 'primary' ? 'text-gold-600' : 'text-gray-500'
            ]}>
              {sponsor.description}
            </span>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <p class="text-sm text-gray-500 mb-4">
          Interested in sponsoring Brooklyn Shamrocks?
        </p>
        <a href="/contact" class="text-shamrock-700 hover:text-shamrock-800 font-bold text-sm inline-flex items-center gap-1 uppercase tracking-wide">
          Get in touch
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Shop carousel scroll buttons
  const shopCarousel = document.getElementById('shop-carousel');
  const shopLeft = document.getElementById('shop-scroll-left');
  const shopRight = document.getElementById('shop-scroll-right');

  shopLeft?.addEventListener('click', () => {
    shopCarousel?.scrollBy({ left: -280, behavior: 'smooth' });
  });
  shopRight?.addEventListener('click', () => {
    shopCarousel?.scrollBy({ left: 280, behavior: 'smooth' });
  });
</script>
