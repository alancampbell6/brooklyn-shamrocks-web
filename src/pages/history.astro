---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const timeline = [
  {
    year: '1955',
    title: 'Club Founded',
    description: 'Brooklyn Shamrocks established by Irish immigrants in Brooklyn, initially with strong Kerry influence. The founding members wanted to maintain their connection to home through the sports they loved.',
    highlight: true,
  },
  {
    year: '1967',
    title: 'Irish Haven, Sunset Park',
    description: 'Irish Haven in Sunset Park with Brooklyn Shamrocks fixtures displayed in the top left corner. Pictured is Irish Haven founder Frank Lawler behind the taps - a glimpse into the Brooklyn Irish community that supported the club.',
    image: '/images/history/1967_irish_haven.jpg',
    imageCaption: 'Frank Lawler at Irish Haven, Sunset Park, 1967',
    imagePosition: 'top',
  },
  {
    year: '1972',
    title: 'Junior Final',
    description: 'Brooklyn Shamrocks competed in the Junior Final during the early years of the club, showcasing the growth and competitive spirit of the organization.',
    image: '/images/history/junior_final_1972.jpeg',
    imageCaption: 'Brooklyn Shamrocks Junior Final, 1972',
    imagePosition: 'top',
  },
  {
    year: '1978',
    title: 'First Annual Dinner Dance',
    description: 'Inaugural Annual Dinner Dance celebration at Bay Ridge Manor, beginning a tradition that continues to this day.',
  },
  {
    year: '1979',
    title: 'The Early Days',
    description: 'Brooklyn Shamrocks in the late 1970s - a glimpse into the club\'s formative years as the community grew and Gaelic football took root in Brooklyn.',
    images: [
      '/images/history/1979.jpeg',
      '/images/history/1979_2.jpeg',
    ],
    imageCaption: 'Brooklyn Shamrocks, 1979',
  },
  {
    year: '1997',
    title: 'Classic Era',
    description: 'The club competed proudly wearing the iconic green jerseys with bold "BROOKLYN" lettering across the chest. A golden era that produced many memorable moments. This team photo features the legendary Pádraic Joyce, who would go on to become one of Galway\'s greatest ever players and All-Ireland winner.',
    image: '/images/history/1997_team_photo.jpg',
    imageCaption: 'Brooklyn Shamrocks team photo, 1997 - featuring Pádraic Joyce',
    highlight: true,
  },
  {
    year: '2002',
    title: 'Shore Road Days',
    description: 'Brooklyn played home games by the Verrazano Bridge on Shore Road in Bay Ridge - a quintessentially Brooklyn setting for Gaelic football. Featured: Declan McAleer (on the ball), Enda Lally (#14), Bobby Murphy & John Egan.',
    images: [
      '/images/history/2002_1.jpg',
      '/images/history/2002_2.jpg',
      '/images/history/2002_3.jpg',
      '/images/history/2002_4.jpg',
    ],
    imageCaption: 'Brooklyn vs Long Island at Shore Road, Bay Ridge',
  },
  {
    year: '2010',
    title: 'Brooklyn Boys Shade It',
    description: 'NY GAA Reports coverage of Brooklyn/Long Island\'s 1-10 to 1-8 victory over Rangers in the intermediate football game at Gaelic Park. Man of the Match: Darren Moore. Featured players included Enda Lally, Declan McAleer, Conor Moore, Denis McGoldrick, and Eoin Delaney.',
    image: '/images/history/newsReport2010.jpg',
    imageCaption: 'NY GAA Reports by Eugene Kyne',
  },
  {
    year: '2011',
    title: 'Brooklyn Shamrocks / Long Island Gaels Partnership',
    description: 'Combined team formed with Long Island Gaels, strengthening both clubs and expanding the reach of Gaelic games in the New York area.',
    image: '/images/history/2011_team_photo.jpg',
    imageCaption: 'Brooklyn Shamrocks / Long Island Gaels combined team',
  },
  {
    year: '2012',
    title: 'Junior B Champions',
    description: 'Won the New York Junior B Football Championship - the first championship in the club\'s modern era, beginning our rise through the divisions.',
    highlight: true,
    images: [
      '/images/history/juniorB_champs.jpg',
      '/images/history/2012_winners.jpeg',
      '/images/history/2012_team.jpeg',
    ],
    imageCaption: 'Junior B Championship winners - our first title',
  },
  {
    year: '2014',
    title: 'Junior A League Champions',
    description: 'Captured the Junior A League title, continuing our upward trajectory through New York GAA.',
    image: '/images/history/2014_team.jpg',
    imageCaption: 'Brooklyn Shamrocks team, 2014',
  },
  {
    year: '2015',
    title: 'Junior A Champions',
    description: 'Won the New York Junior A Football Championship, completing back-to-back successes at Junior A level.',
    highlight: true,
    image: '/images/history/2015_juniorA_champs.jpg',
    imageCaption: 'Junior A Championship celebration',
  },
  {
    year: '2018',
    title: 'Intermediate League Champions',
    description: 'Won the Intermediate League, building momentum toward the championship. That December, the club travelled to Newry, Ireland to play Newry Mitchels in a memorial game honoring Karl Heaney.',
    image: '/images/history/2018_newry_memorial.jpg',
    imageCaption: 'Brooklyn Shamrocks vs Newry Mitchels - Karl Heaney Memorial Game, December 2018',
  },
  {
    year: '2020',
    title: 'Intermediate Champions',
    description: 'Won the New York Intermediate Football Championship, earning promotion to the Senior division.',
    highlight: true,
    image: '/images/history/intermediate_champs_2021.jpg',
    imageCaption: 'Intermediate Championship winners',
  },
  {
    year: '2022',
    title: 'Senior League Champions',
    description: 'Historic first-ever Senior Football League championship. Brooklyn 2-13 defeated Westmeath 1-13 at Gaelic Park under manager Tommy McConvey. Captain Conor Connolly lifted the trophy.',
    highlight: true,
    image: '/images/history/leagueChamps2023.jpg',
    imageCaption: 'Senior League Champions at Gaelic Park',
  },
  {
    year: '2023',
    title: 'New York Make History',
    description: 'Seven Brooklyn Shamrocks players and manager featured as New York achieved their first-ever Connacht SFC victory, defeating Leitrim in a dramatic penalty shootout at Gaelic Park. The match finished 0-15 to 0-15 after extra time. Club stalwart Niall Madine scored a crucial penalty, while Michael Cunningham made key saves in goal. Alan Campbell at full back, Bill Maher at wing back, and Shane Bolger and Paddy Boyle also featured for New York in this historic win after 23 previous attempts.',
    highlight: true,
    image: '/images/history/Brooklyn_players_for_newYork_vs_leitrim_win.jpg',
    imageCaption: 'Brooklyn Shamrocks players and manager after the historic win (R-L): Alan Campbell, Niall Madine, Tommy McConvey (Manager), Bill Maher, Shane Bolger, Paddy Boyle, Michael Cunningham',
    link: 'https://www.rte.ie/sport/football/2023/0408/1375905-new-york-make-history-with-shootout-win-over-leitrim/',
  },
  {
    year: '2025',
    title: '70th Anniversary',
    description: 'The 47th Annual Dinner Dance celebrates 70 years of Brooklyn Shamrocks - seven decades of Gaelic football excellence in Brooklyn.',
    highlight: true,
  },
];

---

<BaseLayout title="Club History" description="The history of Brooklyn Shamrocks GAA since 1955 - our story, achievements, and 70 years of Gaelic football in Brooklyn">
  <Hero
    title="Club History"
    subtitle="70 years of Gaelic football excellence in Brooklyn"
    size="small"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Stats Banner -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
        <div class="bg-shamrock-50 rounded-xl p-6 text-center">
          <div class="text-3xl md:text-4xl font-bold text-shamrock-700">70</div>
          <div class="text-sm text-gray-600">Years of History</div>
        </div>
        <div class="bg-shamrock-50 rounded-xl p-6 text-center">
          <div class="text-3xl md:text-4xl font-bold text-shamrock-700">6</div>
          <div class="text-sm text-gray-600">Championships</div>
        </div>
        <div class="bg-shamrock-50 rounded-xl p-6 text-center">
          <div class="text-3xl md:text-4xl font-bold text-shamrock-700">47</div>
          <div class="text-sm text-gray-600">Dinner Dances</div>
        </div>
        <div class="bg-shamrock-50 rounded-xl p-6 text-center">
          <div class="text-3xl md:text-4xl font-bold text-shamrock-700">2022</div>
          <div class="text-sm text-gray-600">Senior Champs</div>
        </div>
      </div>

      <!-- Introduction -->
      <div class="mb-16">
        <p class="text-xl text-gray-600 leading-relaxed">
          Founded in 1955, Brooklyn Shamrocks GAA is one of New York's oldest and most storied Gaelic football clubs.
          For seven decades, we have been promoting Irish culture and Gaelic games in Brooklyn,
          building a community that feels like family while competing at the highest levels.
        </p>
      </div>

      <!-- Our Story -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Our Story</h2>
        <div class="prose prose-lg max-w-none text-gray-600">
          <p>
            The Brooklyn Shamrocks were founded in 1955 by Irish immigrants who wanted to maintain their connection
            to home through the sports they loved. What started as informal kickabouts in local parks grew
            into an organized club competing at the highest levels in North American GAA.
          </p>
          <p class="mt-4">
            Gaelic Park in the Bronx became our spiritual home for competitive matches - the historic venue
            that has hosted New York GAA since 1928. The sight of the elevated train passing by during matches
            has become an iconic part of our club's story.
          </p>
          <p class="mt-4">
            Through the decades, Brooklyn Shamrocks has evolved while staying true to our founding mission:
            bringing the joy of Gaelic games to Brooklyn and welcoming anyone who shares our passion for
            sport and community.
          </p>
        </div>
      </div>

      <!-- Timeline -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Timeline</h2>
        <div class="relative">
          <!-- Timeline Line -->
          <div class="absolute left-4 md:left-8 top-0 bottom-0 w-0.5 bg-shamrock-200"></div>

          <!-- Timeline Items -->
          <div id="timeline-container" class="space-y-8">
            {timeline.map((item, index) => (
              <div class={`timeline-item relative pl-12 md:pl-20 ${index >= 8 ? 'hidden' : ''}`} data-index={index}>
                <!-- Dot -->
                <div class={`absolute left-2 md:left-6 w-5 h-5 rounded-full border-4 border-white ${item.highlight ? 'bg-gold-500 ring-4 ring-gold-100' : 'bg-shamrock-600'}`}></div>

                <!-- Content -->
                <div class={`${item.highlight ? 'bg-gradient-to-r from-shamrock-50 to-gold-50 border-l-4 border-shamrock-600' : 'bg-white border border-gray-100'} rounded-xl overflow-hidden`}>
                  {item.image && (
                    <button
                      type="button"
                      class="w-full aspect-[16/9] overflow-hidden bg-gray-100 cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-shamrock-500"
                      data-lightbox={item.image}
                      data-caption={item.imageCaption || item.title}
                    >
                      <img
                        src={item.image}
                        alt={item.imageCaption || item.title}
                        class={`w-full h-full object-cover hover:scale-105 transition-transform duration-300 ${item.imagePosition === 'top' ? 'object-top' : ''}`}
                        loading="lazy"
                      />
                    </button>
                  )}
                  {item.images && (
                    <div class="grid grid-cols-2 gap-1 bg-gray-100">
                      {item.images.map((img, idx) => (
                        <button
                          type="button"
                          class="aspect-[4/3] overflow-hidden cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-shamrock-500"
                          data-lightbox={img}
                          data-caption={`${item.imageCaption || item.title} - Photo ${idx + 1}`}
                        >
                          <img
                            src={img}
                            alt={`${item.title} - Photo ${idx + 1}`}
                            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                            loading="lazy"
                          />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="p-6">
                    <span class="text-shamrock-700 font-bold text-lg">{item.year}</span>
                    <h3 class="text-xl font-bold text-gray-900 mt-1">{item.title}</h3>
                    <p class="text-gray-600 mt-2">{item.description}</p>
                    {item.imageCaption && (
                      <p class="text-xs text-gray-400 mt-3 italic">{item.imageCaption}</p>
                    )}
                    {item.link && (
                      <a href={item.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm text-shamrock-700 hover:text-shamrock-800 mt-3 font-medium">
                        Read full article
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Load More Button -->
          <div id="load-more-container" class="mt-8 text-center">
            <button
              id="load-more-btn"
              type="button"
              class="inline-flex items-center gap-2 px-6 py-3 bg-shamrock-700 text-white font-semibold rounded-xl hover:bg-shamrock-800 transition-colors"
            >
              <span>Load More History</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <p id="load-more-count" class="text-sm text-gray-500 mt-2"></p>
          </div>
        </div>
      </div>

      <!-- Lightbox Modal -->
      <div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm">
        <button
          id="lightbox-close"
          type="button"
          class="absolute top-4 right-4 z-10 p-2 text-white/80 hover:text-white transition-colors"
          aria-label="Close"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <div class="flex items-center justify-center w-full h-full p-4">
          <div class="max-w-5xl max-h-full">
            <img
              id="lightbox-img"
              src=""
              alt=""
              class="max-w-full max-h-[85vh] object-contain mx-auto"
            />
            <p id="lightbox-caption" class="text-white/80 text-center mt-4 text-sm"></p>
          </div>
        </div>
      </div>

      <!-- Home Venues -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Our Homes</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-shamrock-50 rounded-xl p-6">
            <h3 class="font-bold text-shamrock-800 mb-2">Gaelic Park, The Bronx</h3>
            <p class="text-gray-600 text-sm">
              Our spiritual home for competitive matches. Historic venue that has hosted New York GAA since 1928.
              The iconic elevated train passing during matches is quintessentially New York GAA.
            </p>
          </div>
          <div class="bg-shamrock-50 rounded-xl p-6">
            <h3 class="font-bold text-shamrock-800 mb-2">Randall's Island</h3>
            <p class="text-gray-600 text-sm">
              Our training base where we develop players of all skill levels. Regular sessions throughout the season
              from March to September.
            </p>
          </div>
        </div>
      </div>

      <!-- Link to Honours -->
      <div class="mb-16">
        <a href="/honours" class="block bg-gradient-to-r from-shamrock-700 to-shamrock-800 rounded-2xl p-8 text-white hover:from-shamrock-800 hover:to-shamrock-900 transition-all">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-2xl font-bold mb-2">Honours & Awards</h3>
              <p class="text-shamrock-100">View our championship wins and individual award recipients</p>
            </div>
            <svg class="w-8 h-8 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      </div>

      <!-- The Future -->
      <div class="bg-shamrock-900 text-white p-8 rounded-2xl">
        <h2 class="text-2xl font-bold mb-4">The Future</h2>
        <p class="text-shamrock-100 mb-6">
          As we celebrate 70 years in 2025, Brooklyn Shamrocks continues to grow, welcoming new members
          and developing the next generation of Gaelic athletes. We remain committed to our founding mission:
          bringing the joy of Gaelic games to Brooklyn.
        </p>
        <p class="text-shamrock-100">
          Whether you're a seasoned player or completely new to GAA, you're welcome at Brooklyn Shamrocks.
        </p>
        <a href="/contact" class="btn btn-secondary mt-6">
          Get Involved
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Load More functionality
  const ITEMS_PER_PAGE = 8;
  let visibleCount = ITEMS_PER_PAGE;
  const timelineItems = document.querySelectorAll('.timeline-item');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreContainer = document.getElementById('load-more-container');
  const loadMoreCount = document.getElementById('load-more-count');
  const totalItems = timelineItems.length;

  function updateLoadMoreButton() {
    const remaining = totalItems - visibleCount;
    if (remaining <= 0) {
      loadMoreContainer?.classList.add('hidden');
    } else {
      loadMoreCount!.textContent = `Showing ${visibleCount} of ${totalItems} moments`;
    }
  }

  function showMoreItems() {
    const nextCount = Math.min(visibleCount + ITEMS_PER_PAGE, totalItems);
    timelineItems.forEach((item, index) => {
      if (index < nextCount) {
        item.classList.remove('hidden');
      }
    });
    visibleCount = nextCount;
    updateLoadMoreButton();
  }

  loadMoreBtn?.addEventListener('click', showMoreItems);
  updateLoadMoreButton();

  // Lightbox functionality
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxTriggers = document.querySelectorAll('[data-lightbox]');

  function openLightbox(src: string, caption: string) {
    if (lightbox && lightboxImg && lightboxCaption) {
      lightboxImg.src = src;
      lightboxImg.alt = caption;
      lightboxCaption.textContent = caption;
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  lightboxTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const src = trigger.getAttribute('data-lightbox') || '';
      const caption = trigger.getAttribute('data-caption') || '';
      openLightbox(src, caption);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeLightbox();
    }
  });
</script>
