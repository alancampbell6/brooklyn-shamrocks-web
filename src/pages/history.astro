---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const timeline = [
  {
    era: 'The Early Years',
    description: 'The club was established by a group of passionate Gaels who gathered weekly to play football in Brooklyn\'s parks. These informal games attracted more and more players, creating a need for formal organization.',
  },
  {
    era: 'Growth Period',
    description: 'As the club grew, we established formal training programs, joined official competitions, and began building the structures needed for sustained success. Gaelic Park in the Bronx became our spiritual home for competitive matches.',
  },
  {
    era: 'Modern Era',
    description: 'Today, Brooklyn Shamrocks fields teams at senior and junior levels in Gaelic football. Our teams compete for championships each season, carrying on the proud tradition of Gaelic games in Brooklyn.',
  },
];

const honours = [
  {
    category: 'Senior Football',
    achievements: [
      'New York Senior Football Championship winners',
      'Multiple league titles',
      'Consistent competitors in national competitions',
    ],
  },
  {
    category: 'Junior Football',
    achievements: [
      'New York Junior Football Championship competitors',
      'Development pathway for emerging players',
      'Strong squad depth and competition',
    ],
  },
  {
    category: 'Club Culture',
    achievements: [
      'Active social calendar and community events',
      'Strong Irish cultural connections',
      'Welcoming environment for all skill levels',
    ],
  },
];
---

<BaseLayout title="Club History" description="The history of Brooklyn Shamrocks GAA - our story, achievements, and honours">
  <Hero
    title="Club History"
    subtitle="A proud tradition of Gaelic games in Brooklyn"
    size="small"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Introduction -->
      <div class="mb-16">
        <p class="text-xl text-gray-600 leading-relaxed">
          Brooklyn Shamrocks GAA has a proud history of promoting Gaelic games in Brooklyn, New York.
          From humble beginnings to becoming a cornerstone of the New York GAA community, our story
          is one of dedication, community, and sporting excellence.
        </p>
      </div>

      <!-- Our Story -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Our Story</h2>
        <p class="text-gray-600 leading-relaxed">
          The Brooklyn Shamrocks were founded by Irish immigrants who wanted to maintain their connection
          to home through the sports they loved. What started as informal kickabouts in local parks grew
          into an organized club competing at the highest levels in North American GAA.
        </p>
      </div>

      <!-- Honours -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Honours & Achievements</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {honours.map((section) => (
            <div class="bg-gradient-to-br from-shamrock-50 to-shamrock-100 p-6 rounded-xl">
              <h3 class="font-bold text-shamrock-800 mb-4">{section.category}</h3>
              <ul class="space-y-2">
                {section.achievements.map((achievement) => (
                  <li class="flex items-start gap-2 text-sm text-gray-700">
                    <svg class="w-4 h-4 text-gold-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                    {achievement}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Timeline -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Timeline</h2>
        <div class="relative">
          <!-- Timeline Line -->
          <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-shamrock-200 transform md:-translate-x-1/2"></div>

          <!-- Timeline Items -->
          <div class="space-y-12">
            {timeline.map((item, index) => (
              <div class={`relative flex items-start gap-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                <!-- Dot -->
                <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-shamrock-600 rounded-full transform -translate-x-1/2 md:-translate-x-1/2 z-10 ring-4 ring-white"></div>

                <!-- Content -->
                <div class={`ml-12 md:ml-0 md:w-1/2 ${index % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:pl-12'}`}>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">{item.era}</h3>
                  <p class="text-gray-600">{item.description}</p>
                </div>

                <!-- Spacer for alternating layout -->
                <div class="hidden md:block md:w-1/2"></div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Notable Figures -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Notable Figures</h2>
        <p class="text-gray-600 mb-4">
          Over the years, many dedicated individuals have contributed to our success:
        </p>
        <ul class="grid sm:grid-cols-2 gap-4">
          <li class="flex items-center gap-3 text-gray-700">
            <div class="w-2 h-2 bg-shamrock-500 rounded-full"></div>
            Players who represented New York in national competitions
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <div class="w-2 h-2 bg-shamrock-500 rounded-full"></div>
            Volunteers who built our club infrastructure
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <div class="w-2 h-2 bg-shamrock-500 rounded-full"></div>
            Coaches who developed multiple generations of players
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <div class="w-2 h-2 bg-shamrock-500 rounded-full"></div>
            Supporters who stood by us through all seasons
          </li>
        </ul>
      </div>

      <!-- The Future -->
      <div class="bg-shamrock-900 text-white p-8 rounded-2xl">
        <h2 class="text-2xl font-bold mb-4">The Future</h2>
        <p class="text-shamrock-100 mb-6">
          Brooklyn Shamrocks continues to grow, welcoming new members and developing the next generation
          of Gaelic athletes. We remain committed to our founding mission: bringing the joy of Gaelic
          games to Brooklyn.
        </p>
        <p class="text-shamrock-100">
          Whether you're a seasoned player or completely new to GAA, you're welcome at Brooklyn Shamrocks.
        </p>
        <a href="/contact" class="btn btn-secondary mt-6">
          Get Involved
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
