---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

import teamsData from '../../data/teams.json';

const teams = teamsData.teams;
---

<BaseLayout title="Teams" description="Brooklyn Shamrocks GAA teams - Senior Football and Junior Football">
  <Hero
    title="Our Teams"
    subtitle="Join our Senior or Junior Football teams and find your place on the pitch"
    size="small"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        {teams.map((team) => (
          <a href={`/teams/${team.slug}`} class="card group overflow-hidden">
            <!-- Team Header -->
            <div class="bg-gradient-to-r from-shamrock-700 to-shamrock-600 p-6 text-white">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-xl font-bold">{team.name}</h2>
                  <p class="text-shamrock-200 text-sm">{team.sport}</p>
                </div>
                <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center group-hover:bg-white/30 transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Team Info -->
            <div class="p-6">
              <p class="text-gray-600 mb-4 line-clamp-2">{team.description}</p>

              <div class="space-y-2 text-sm">
                <div class="flex items-center gap-2 text-gray-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>{team.trainingDays} at {team.trainingTime}</span>
                </div>
                <div class="flex items-center gap-2 text-gray-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{team.trainingLocation}</span>
                </div>
              </div>

              <div class="mt-4 pt-4 border-t border-gray-100">
                <span class="text-shamrock-700 font-medium text-sm group-hover:text-shamrock-800 inline-flex items-center gap-1">
                  Learn more
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Join CTA -->
      <div class="mt-16 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">New to Gaelic Games?</h2>
        <p class="text-gray-600 max-w-2xl mx-auto mb-8">
          No experience necessary! We welcome players of all backgrounds and skill levels.
          Come to a training session and discover the excitement of Gaelic games.
        </p>
        <a href="/contact" class="btn btn-primary">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
