---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FixtureCard from '../../components/FixtureCard.astro';
import ResultCard from '../../components/ResultCard.astro';

import teamsData from '../../data/teams.json';
import fixturesData from '../../data/fixtures.json';
import resultsData from '../../data/results.json';

export function getStaticPaths() {
  return teamsData.teams.map(team => ({
    params: { team: team.slug },
    props: { team },
  }));
}

const { team } = Astro.props;

// Compare date strings directly (YYYY-MM-DD sorts lexicographically) to avoid
// timezone off-by-one issues when comparing UTC-parsed dates to local time.
const todayStr = new Date().toLocaleDateString('en-CA'); // en-CA gives YYYY-MM-DD in local time
const teamFixtures = fixturesData.fixtures
  .filter(f => f.team === team.shortName && f.date >= todayStr)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 3);

const teamResults = resultsData.results
  .filter(r => r.team === team.shortName)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// BreadcrumbList schema for this team page
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://brooklynshamrocks.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Teams",
      "item": "https://brooklynshamrocks.com/teams"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": team.name,
      "item": `https://brooklynshamrocks.com/teams/${team.slug}`
    }
  ]
};
---

<BaseLayout title={team.name} description={team.description} schema={breadcrumbSchema}>
  <Hero
    title={team.name}
    subtitle={team.sport}
    size="small"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back Link -->
      <a href="/teams" class="inline-flex items-center gap-2 text-shamrock-700 hover:text-shamrock-800 mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Teams
      </a>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Description -->
          <div class="prose prose-lg max-w-none">
            <p class="text-gray-600 leading-relaxed">{team.description}</p>
          </div>

          <!-- Competitions -->
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4">Competitions</h2>
            <div class="flex flex-wrap gap-2">
              {team.competitions.map((comp: string) => (
                <span class="px-4 py-2 bg-shamrock-100 text-shamrock-700 rounded-full text-sm font-medium">
                  {comp}
                </span>
              ))}
            </div>
          </div>

          <!-- Upcoming Fixtures -->
          {teamFixtures.length > 0 && (
            <div>
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-bold text-gray-900">Upcoming Fixtures</h2>
                <a href="/fixtures" class="text-sm text-shamrock-700 hover:text-shamrock-800">
                  View all
                </a>
              </div>
              <div class="grid md:grid-cols-2 gap-4">
                {teamFixtures.map((fixture) => (
                  <FixtureCard {...fixture} />
                ))}
              </div>
            </div>
          )}

          <!-- Recent Results -->
          {teamResults.length > 0 && (
            <div>
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-bold text-gray-900">Recent Results</h2>
                <a href="/results" class="text-sm text-shamrock-700 hover:text-shamrock-800">
                  View all
                </a>
              </div>
              <div class="grid md:grid-cols-2 gap-4">
                {teamResults.map((result) => (
                  <ResultCard {...result} />
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <!-- Training Info Card -->
            <div class="bg-shamrock-50 p-6 rounded-2xl">
              <h3 class="font-bold text-gray-900 mb-4">Training Schedule</h3>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-shamrock-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">{team.trainingDays}</p>
                    <p class="text-sm text-gray-600">{team.trainingTime}</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-shamrock-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">{team.trainingLocation}</p>
                    <p class="text-sm text-gray-600">New York, NY</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Contact Card -->
            <div class="bg-gray-50 p-6 rounded-2xl">
              <h3 class="font-bold text-gray-900 mb-4">Contact</h3>
              <a href={`mailto:${team.contact}`} class="flex items-center gap-3 text-shamrock-700 hover:text-shamrock-800">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span class="text-sm break-all">{team.contact}</span>
              </a>
            </div>

            <!-- Join CTA -->
            <div class="bg-shamrock-900 text-white p-6 rounded-2xl">
              <h3 class="font-bold mb-2">Join the Team</h3>
              <p class="text-sm text-shamrock-200 mb-4">
                Interested in playing? Come to a training session - all skill levels welcome!
              </p>
              <a href="/contact" class="btn btn-secondary w-full justify-center">
                Get in Touch
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
