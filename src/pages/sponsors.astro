// Deduplicate each list
function unique(arr: string[]) {
  const seen = new Set<string>();
  return arr.filter(s => {
    const key = s.toLowerCase();
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

const uniqueCorporate = unique(corporateSponsors);
const uniqueBars = unique(barsAndRestaurants);
const uniqueIndividual = unique(individualSupporters);
---

<BaseLayout title="Sponsors" description="Brooklyn Shamrocks GAA proudly thanks all our sponsors and supporters. From title sponsors to individual donors, your generosity makes our club possible." breadcrumbs={[{ name: 'Sponsors', href: '/sponsors' }]}>
  <Hero
    title="Our Sponsors"
    subtitle="Brooklyn Shamrocks GAA is deeply grateful to every sponsor and supporter who makes our club possible. Your generosity funds our teams, our players, and our community."
    size="small"
    bottomColor="#f9fafb"
  />

  <!-- Title Sponsors -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 uppercase tracking-tight mb-2">Title Sponsors</h2>
        <p class="text-gray-600">Our principal partners who lead the way in supporting Brooklyn Shamrocks</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 md:gap-10 max-w-4xl mx-auto">
        {titleSponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center p-8 bg-white shadow-md hover:shadow-lg transition-all overflow-hidden"
          >
            <div class="flex items-center justify-center h-24 w-full mb-4">
              <picture>
                <source srcset={sponsor.logo.replace('.png', '.webp')} type="image/webp" />
                <img
                  src={sponsor.logo}
                  alt={sponsor.name}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform"
                />
              </picture>
            </div>
            <span class="text-sm font-semibold text-gold-600">{sponsor.description}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Corporate & Business Sponsors -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 uppercase tracking-tight mb-2">Corporate & Business Sponsors</h2>
        <p class="text-gray-600">The businesses that back our club season after season</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {uniqueCorporate.map((name) => (
          <div class="bg-gray-50 border border-gray-100 px-4 py-4 flex items-center justify-center text-center hover:bg-shamrock-50 hover:border-shamrock-200 transition-colors">
            <span class="text-sm font-semibold text-gray-800">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bars & Restaurants -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 uppercase tracking-tight mb-2">Bars & Restaurants</h2>
        <p class="text-gray-600">The pubs and restaurants that are part of our Shamrocks community</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {uniqueBars.map((name) => (
          <div class="bg-white border border-gray-100 px-4 py-4 flex items-center justify-center text-center hover:bg-shamrock-50 hover:border-shamrock-200 transition-colors">
            <span class="text-sm font-semibold text-gray-800">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Individual Supporters -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 uppercase tracking-tight mb-2">Individual Supporters</h2>
        <p class="text-gray-600">The individuals and families whose generosity keeps our club thriving</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {uniqueIndividual.map((name) => (
          <div class="bg-gray-50 border border-gray-100 px-4 py-4 flex items-center justify-center text-center hover:bg-shamrock-50 hover:border-shamrock-200 transition-colors">
            <span class="text-sm font-semibold text-gray-800">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Thank You CTA -->
  <section class="py-12 md:py-16 bg-shamrock-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white uppercase tracking-tight mb-4">Thank You</h2>
      <p class="text-shamrock-100 mb-4">
        Brooklyn Shamrocks GAA would not exist without the incredible support of our sponsors, businesses, and individual donors. Every contribution — big or small — goes directly toward keeping Gaelic football alive in New York.
      </p>
      <p class="text-shamrock-100 mb-8">
        From covering pitch fees and equipment, to supporting our players and events, your generosity is the backbone of this club. We are forever grateful.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn btn-secondary btn-sharp uppercase tracking-wide">
          Become a Sponsor
        </a>
        <a href="/contact" class="btn btn-sharp border-2 border-white text-white hover:bg-white hover:text-shamrock-900 uppercase tracking-wide">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
