---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About" description="Learn about Brooklyn Shamrocks GAA - our mission, membership, and training schedule">
  <Hero
    title="About Us"
    subtitle="Building community through Gaelic games since our founding"
    size="small"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Introduction -->
      <div class="prose prose-lg max-w-none">
        <p class="text-xl text-gray-600 mb-8">
          Brooklyn Shamrocks GAA is a Gaelic Athletic Association club based in Brooklyn, New York.
          We are dedicated to promoting Irish culture and Gaelic games in our community.
        </p>
      </div>

      <!-- Mission Section -->
      <div class="mb-12" id="mission">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Our Mission</h2>
        <p class="text-gray-600">
          To foster a love of Gaelic games while building a supportive community that celebrates Irish heritage.
          We welcome players of all backgrounds and skill levels who share our passion for sport and camaraderie.
        </p>
      </div>

      <!-- What We Do -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">What We Do</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-shamrock-50 p-6 rounded-xl">
            <h3 class="font-semibold text-shamrock-800 mb-2">Senior Football</h3>
            <p class="text-sm text-gray-600">Our flagship team competing at the highest level in New York GAA</p>
          </div>
          <div class="bg-shamrock-50 p-6 rounded-xl">
            <h3 class="font-semibold text-shamrock-800 mb-2">Junior Football</h3>
            <p class="text-sm text-gray-600">A pathway for developing players and those new to the game</p>
          </div>
        </div>
      </div>

      <!-- Membership Section -->
      <div class="mb-12 bg-gray-50 p-8 rounded-2xl" id="membership">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Membership</h2>
        <p class="text-gray-600 mb-6">
          Membership is open to anyone interested in playing Gaelic games or supporting our club.
        </p>
        <h3 class="font-semibold text-gray-900 mb-3">Benefits include:</h3>
        <ul class="space-y-2 text-gray-600 mb-6">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-shamrock-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Access to all training sessions
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-shamrock-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Club gear at member prices
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-shamrock-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Social event invitations
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-shamrock-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Voting rights at AGM
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-shamrock-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Connection to the global GAA community
          </li>
        </ul>
        <a href="/contact" class="btn btn-primary">
          Join the Club
        </a>
      </div>

      <!-- Training Schedule -->
      <div class="mb-12" id="training">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Training Schedule</h2>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Team</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Day</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Time</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Location</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr>
                <td class="py-3 px-4 text-gray-900">Senior Football</td>
                <td class="py-3 px-4 text-gray-600">Tuesday & Thursday</td>
                <td class="py-3 px-4 text-gray-600">7:00 PM</td>
                <td class="py-3 px-4 text-gray-600">Randalls Island Field 73</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-gray-900">Junior Football</td>
                <td class="py-3 px-4 text-gray-600">Tuesday & Thursday</td>
                <td class="py-3 px-4 text-gray-600">7:00 PM</td>
                <td class="py-3 px-4 text-gray-600">Randalls Island Field 73</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-gray-500 mt-4">
          Training schedules may vary seasonally. Contact us for the latest information.
        </p>
      </div>

      <!-- Affiliations -->
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Affiliations</h2>
        <p class="text-gray-600 mb-4">Brooklyn Shamrocks is a proud member of:</p>
        <div class="flex flex-wrap gap-4">
          <span class="px-4 py-2 bg-gray-100 rounded-full text-gray-700 font-medium">NAGAA</span>
          <span class="px-4 py-2 bg-gray-100 rounded-full text-gray-700 font-medium">New York GAA Board</span>
          <span class="px-4 py-2 bg-gray-100 rounded-full text-gray-700 font-medium">GAA</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
