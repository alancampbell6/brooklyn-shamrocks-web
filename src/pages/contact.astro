---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// LocalBusiness schema for training location
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": "Brooklyn Shamrocks GAA Training Ground",
  "description": "Training location for Brooklyn Shamrocks GAA, New York's oldest Gaelic Athletic Association club.",
  "url": "https://brooklynshamrocks.com/contact",
  "telephone": "",
  "email": "info@brooklynshamrocks.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Randalls Island Field 73",
    "addressLocality": "New York",
    "addressRegion": "NY",
    "postalCode": "10035",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "40.7931",
    "longitude": "-73.9214"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Tuesday",
      "opens": "19:00",
      "closes": "21:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Thursday",
      "opens": "19:00",
      "closes": "21:00"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/BrooklynShamrocks/",
    "https://www.instagram.com/brooklynshamrocksgfc",
    "https://x.com/bklynshamrocks"
  ]
};
---

<BaseLayout title="Contact" description="Get in touch with Brooklyn Shamrocks GAA - location, contact info, and directions" schema={localBusinessSchema}>
  <Hero
    title="Contact Us"
    subtitle="Get in touch with Brooklyn Shamrocks GAA"
    size="small"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Information -->
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Get in Touch</h2>

          <div class="space-y-6">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-shamrock-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-shamrock-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Email</h3>
                <a href="mailto:info@brooklynshamrocks.com" class="text-shamrock-700 hover:text-shamrock-800">
                  info@brooklynshamrocks.com
                </a>
                <p class="text-sm text-gray-500 mt-1">We'll respond within 48 hours</p>
              </div>
            </div>

            <!-- Training Location -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-shamrock-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-shamrock-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Training Location</h3>
                <p class="text-gray-600">Randalls Island Field 73</p>
                <p class="text-gray-600">Randalls Island Park</p>
                <p class="text-gray-600">New York, NY 10035</p>
                <p class="text-sm text-gray-500 mt-1">Near the Icahn Stadium</p>
              </div>
            </div>

            <!-- Match Venue -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-shamrock-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-shamrock-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Match Venue</h3>
                <p class="text-gray-600">Gaelic Park</p>
                <p class="text-gray-600">4702 Broadway</p>
                <p class="text-gray-600">Bronx, NY 10040</p>
                <p class="text-sm text-gray-500 mt-1">Home of New York GAA</p>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="mt-8">
            <h3 class="font-semibold text-gray-900 mb-4">Follow Us</h3>
            <div class="flex gap-4">
              <a href="https://www.facebook.com/BrooklynShamrocks/" target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center hover:bg-shamrock-100 hover:text-shamrock-700 transition-colors" aria-label="Facebook">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href="https://www.instagram.com/brooklynshamrocksgfc" target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center hover:bg-shamrock-100 hover:text-shamrock-700 transition-colors" aria-label="Instagram">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </a>
              <a href="https://x.com/bklynshamrocks" target="_blank" rel="noopener noreferrer" class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center hover:bg-shamrock-100 hover:text-shamrock-700 transition-colors" aria-label="X (Twitter)">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Find Us</h2>
          <div class="bg-gray-100 rounded-2xl overflow-hidden h-80 md:h-96">
            <iframe
              src="https://maps.google.com/maps?q=Randalls+Island+Field+73,+New+York,+NY+10035&output=embed&z=16"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Brooklyn Shamrocks Training Location - Randalls Island Field 73"
            ></iframe>
          </div>

          <!-- Directions -->
          <div class="mt-6 bg-gray-50 p-6 rounded-xl">
            <h3 class="font-semibold text-gray-900 mb-4">Getting There</h3>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="inline-flex items-center justify-center w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex-shrink-0">M35</span>
                <p class="text-gray-600">M35 bus from 125th St (Lexington Ave) directly to Randalls Island</p>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <p class="text-gray-600">Walk or bike via the 103rd St Footbridge from East Harlem</p>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 4h8m-6 4h4M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z" />
                </svg>
                <p class="text-gray-600">By car: RFK Bridge to Randalls Island, free parking available</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact CTA -->
      <div class="mt-16 bg-shamrock-900 text-white p-8 md:p-12 rounded-2xl text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Ready to Join?</h2>
        <p class="text-shamrock-100 max-w-2xl mx-auto mb-8">
          Whether you're an experienced player or completely new to Gaelic games,
          we'd love to hear from you. Drop by training or send us a message!
        </p>
        <a href="mailto:info@brooklynshamrocks.com" class="btn btn-secondary">
          Send Us an Email
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
