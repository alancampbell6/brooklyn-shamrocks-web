---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FixtureCard from '../components/FixtureCard.astro';
import SectionHeading from '../components/SectionHeading.astro';

import fixturesData from '../data/fixtures.json';

// Get all upcoming fixtures
const upcomingFixtures = fixturesData.fixtures
  .filter(f => new Date(f.date) >= new Date())
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

// Get unique team filters
const teams = [...new Set(fixturesData.fixtures.map(f => f.team))].sort();

// Group fixtures by month
const fixturesByMonth = upcomingFixtures.reduce((acc, fixture) => {
  const date = new Date(fixture.date);
  const monthKey = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  if (!acc[monthKey]) acc[monthKey] = [];
  acc[monthKey].push(fixture);
  return acc;
}, {} as Record<string, typeof upcomingFixtures>);
---

<BaseLayout title="Fixtures" description="Upcoming fixtures and matches for Brooklyn Shamrocks GAA">
  <Hero
    title="Fixtures"
    subtitle="Upcoming matches and events for all our teams"
    size="small"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filter Controls -->
      <div class="mb-8 flex flex-wrap gap-2" id="filter-controls">
        <button
          class="filter-btn active px-4 py-2 rounded-full text-sm font-medium transition-colors bg-shamrock-700 text-white"
          data-filter="all"
        >
          All Teams
        </button>
        {teams.map((team) => (
          <button
            class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200"
            data-filter={team}
          >
            {team}
          </button>
        ))}
      </div>

      <!-- Fixtures List -->
      {upcomingFixtures.length > 0 ? (
        <div id="fixtures-container">
          {Object.entries(fixturesByMonth).map(([month, fixtures]) => (
            <div class="mb-12">
              <h2 class="text-xl font-semibold text-gray-900 mb-6 pb-2 border-b border-gray-200">
                {month}
              </h2>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {fixtures.map((fixture) => (
                  <div class="fixture-item" data-team={fixture.team}>
                    <FixtureCard {...fixture} />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <div class="w-16 h-16 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">No Upcoming Fixtures</h3>
          <p class="text-gray-500">Check back soon for our upcoming schedule.</p>
        </div>
      )}

      <!-- Last Updated -->
      <div class="mt-8 text-center text-sm text-gray-500">
        Last updated: {new Date(fixturesData.lastUpdated).toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll('.filter-btn');
  const fixtureItems = document.querySelectorAll('.fixture-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active button
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-shamrock-700', 'text-white');
        b.classList.add('bg-gray-100', 'text-gray-700');
      });
      btn.classList.add('active', 'bg-shamrock-700', 'text-white');
      btn.classList.remove('bg-gray-100', 'text-gray-700');

      // Filter fixtures
      fixtureItems.forEach(item => {
        const team = item.getAttribute('data-team');
        if (filter === 'all' || team === filter) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
