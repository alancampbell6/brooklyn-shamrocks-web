---
import BaseLayout from '../layouts/BaseLayout.astro';

import fixturesData from '../data/fixtures.json';
import resultsData from '../data/results.json';
import videosData from '../data/videos.json';
import teamColors from '../data/teamColors.json';
import { CLUB_NAME } from '../lib/constants';
import { getOutcome, parseGAAScore, findVideoUrl, OUTCOME_COLORS, OUTCOME_LABELS, OUTCOME_ARIA_LABELS } from '../lib/gaa';

const colors = teamColors as Record<string, string>;
function getColor(team: string) { return colors[team] || '#9ca3af'; }

// --- League Tables / Standings ---
interface Standing {
  team: string;
  played: number;
  wins: number;
  draws: number;
  losses: number;
  pointsFor: number;
  pointsAgainst: number;
  pointsDiff: number;
  totalPoints: number;
}

function buildStandings(competition: string): Standing[] {
  // Get all teams from fixtures for this competition
  const teamSet = new Set<string>();
  fixturesData.fixtures
    .filter(f => f.competition === competition)
    .forEach(f => { teamSet.add(f.homeTeam); teamSet.add(f.awayTeam); });

  // Init standings
  const map = new Map<string, Standing>();
  for (const team of teamSet) {
    map.set(team, { team, played: 0, wins: 0, draws: 0, losses: 0, pointsFor: 0, pointsAgainst: 0, pointsDiff: 0, totalPoints: 0 });
  }

  // Tally results (GAA: 2 pts for win, 1 for draw)
  resultsData.results
    .filter(r => r.competition === competition)
    .forEach(r => {
      const home = map.get(r.homeTeam);
      const away = map.get(r.awayTeam);
      if (!home || !away) return;

      const homeTotal = parseGAAScore(r.homeScore);
      const awayTotal = parseGAAScore(r.awayScore);

      home.played++; away.played++;
      home.pointsFor += homeTotal; home.pointsAgainst += awayTotal;
      away.pointsFor += awayTotal; away.pointsAgainst += homeTotal;

      if (homeTotal > awayTotal) {
        home.wins++; away.losses++;
        home.totalPoints += 2;
      } else if (homeTotal < awayTotal) {
        away.wins++; home.losses++;
        away.totalPoints += 2;
      } else {
        home.draws++; away.draws++;
        home.totalPoints += 1; away.totalPoints += 1;
      }
    });

  // Compute diff and sort: points desc, then diff desc, then pointsFor desc
  for (const s of map.values()) {
    s.pointsDiff = s.pointsFor - s.pointsAgainst;
  }

  return [...map.values()].sort((a, b) =>
    b.totalPoints - a.totalPoints || b.pointsDiff - a.pointsDiff || b.pointsFor - a.pointsFor || a.team.localeCompare(b.team)
  );
}

const seniorStandings = buildStandings('NY Senior Football Championship');
const juniorStandings = buildStandings('NY Junior Football Championship');

// --- Fixtures ---

// Compare date strings directly (YYYY-MM-DD sorts lexicographically) to avoid
// timezone off-by-one issues when comparing UTC-parsed dates to local time.
const todayStr = new Date().toLocaleDateString('en-CA');
const upcomingFixtures = fixturesData.fixtures
  .filter(f => f.date >= todayStr)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const fixtureTeams = [...new Set(fixturesData.fixtures.map(f => f.team))].sort();

// SportsEvent schema for upcoming fixtures
const fixturesSchema = upcomingFixtures.length > 0 ? upcomingFixtures.map(fixture => ({
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": `${fixture.homeTeam} vs ${fixture.awayTeam}`,
  "startDate": fixture.date,
  "location": {
    "@type": "Place",
    "name": fixture.venue || "Gaelic Park",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "New York",
      "addressRegion": "NY",
      "addressCountry": "US"
    }
  },
  "homeTeam": {
    "@type": "SportsTeam",
    "name": fixture.homeTeam
  },
  "awayTeam": {
    "@type": "SportsTeam",
    "name": fixture.awayTeam
  },
  "sport": "Gaelic Football",
  "eventStatus": "https://schema.org/EventScheduled"
})) : null;

// Split fixtures: first = featured, rest = rows
const featuredFixture = upcomingFixtures[0] || null;
const remainingFixtures = upcomingFixtures.slice(1);

// --- Results ---

const sortedResults = [...resultsData.results].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const years = [...new Set(resultsData.results.map(r => new Date(r.date).getFullYear()))].sort((a, b) => b - a);
const resultTeams = [...new Set(resultsData.results.map(r => r.team))].sort();

const resultsWithOutcome = sortedResults.map(result => {
  const shamrocksIsHome = result.homeTeam === CLUB_NAME;
  const shamrocksScore = shamrocksIsHome ? result.homeScore : result.awayScore;
  const opponentScore = shamrocksIsHome ? result.awayScore : result.homeScore;
  return {
    ...result,
    year: new Date(result.date).getFullYear(),
    outcome: getOutcome(shamrocksScore, opponentScore),
    videoUrl: findVideoUrl(result, videosData.videos)
  };
});

// Split results: first = featured, rest = rows
const featuredResult = resultsWithOutcome[0] || null;
const remainingResults = resultsWithOutcome.slice(1);

// Helper: format date for rows
function formatRowDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return {
    dayName: d.toLocaleDateString('en-US', { weekday: 'short' }).toUpperCase(),
    day: d.getDate(),
    month: d.toLocaleDateString('en-US', { month: 'short' }).toUpperCase(),
    year: d.getFullYear(),
    full: d.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })
  };
}

const outcomeColors = OUTCOME_COLORS;
const outcomeLabels = OUTCOME_LABELS;
---

<BaseLayout title="Matches - Fixtures & Results" description="Brooklyn Shamrocks GAA fixtures and results for junior and senior football in New York. View upcoming New York GAA match schedules, scores, and competition details." schema={fixturesSchema} breadcrumbs={[{ name: 'Matches', href: '/matches' }]}>

  <!-- Tab Bar (CPFC-style bordered tabs) -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-0 flex justify-center">
      <div class="inline-flex border border-gray-300 rounded-md overflow-hidden" role="tablist">
        <button
          id="tab-fixtures"
          role="tab"
          aria-selected="true"
          aria-controls="panel-fixtures"
          class="tab-btn px-6 sm:px-8 py-2.5 text-base sm:text-lg font-bold uppercase tracking-wide text-shamrock-700 bg-white transition-colors"
        >
          Fixtures
        </button>
        <button
          id="tab-results"
          role="tab"
          aria-selected="false"
          aria-controls="panel-results"
          class="tab-btn px-6 sm:px-8 py-2.5 text-base sm:text-lg font-bold uppercase tracking-wide text-gray-400 bg-white border-l border-gray-300 hover:text-shamrock-700 transition-colors"
        >
          Results
        </button>
        <button
          id="tab-tables"
          role="tab"
          aria-selected="false"
          aria-controls="panel-tables"
          class="tab-btn px-6 sm:px-8 py-2.5 text-base sm:text-lg font-bold uppercase tracking-wide text-gray-400 bg-white border-l border-gray-300 hover:text-shamrock-700 transition-colors"
        >
          Tables
        </button>
      </div>
    </div>
  </div>

  <!-- Content -->
  <section class="bg-gray-50 min-h-[40vh]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

      <!-- ==================== FIXTURES PANEL ==================== -->
      <div id="panel-fixtures" role="tabpanel" aria-labelledby="tab-fixtures">

        <!-- Fixture Filters -->
        {fixtureTeams.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2" id="fixture-filter-controls">
            <button
              class="fixture-filter-btn active px-4 py-1.5 rounded-full text-sm font-semibold transition-colors bg-shamrock-700 text-white"
              data-filter="all"
            >
              All Teams
            </button>
            {fixtureTeams.map((team) => (
              <button
                class="fixture-filter-btn px-4 py-1.5 rounded-full text-sm font-semibold transition-colors bg-white text-gray-600 hover:bg-gray-100 border border-gray-200"
                data-filter={team}
              >
                {team}
              </button>
            ))}
          </div>
        )}

        {upcomingFixtures.length > 0 ? (
          <div id="fixtures-container">
            {/* Featured Next Match */}
            {featuredFixture && (
              <div class="fixture-item bg-white rounded-lg shadow-sm border border-gray-100 p-6 md:p-8 mb-6" data-team={featuredFixture.team}>
                <div class="text-center">
                  <span class="inline-block px-3 py-1 bg-shamrock-600 text-white text-xs font-bold uppercase tracking-wider rounded-full mb-4">
                    Next Match
                  </span>
                  <p class="text-sm text-gray-500 mb-6">
                    {featuredFixture.competition} &middot; {featuredFixture.round || ''} &middot; {featuredFixture.venue}
                  </p>

                  {/* Teams & Date */}
                  <div class="flex items-center justify-center gap-6 md:gap-10">
                    {/* Home Team */}
                    <div class="flex-1 text-center">
                      <div class="w-16 h-16 md:w-20 md:h-20 mx-auto mb-3 rounded-full flex items-center justify-center overflow-hidden" style={featuredFixture.homeTeam === CLUB_NAME ? '' : `background-color: ${getColor(featuredFixture.homeTeam)}`}>
                        {featuredFixture.homeTeam === CLUB_NAME ? (
                          <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="56" height="56" loading="lazy" class="w-14 h-14 md:w-16 md:h-16 object-contain" />
                        ) : (
                          <span class="text-white font-bold text-lg md:text-xl">{featuredFixture.homeTeam.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <p class="font-bold text-gray-900 text-sm md:text-base">{featuredFixture.homeTeam}</p>
                    </div>

                    {/* Date/Time Center */}
                    <div class="flex-shrink-0 text-center">
                      <div class="text-2xl md:text-3xl font-bold text-shamrock-700">
                        {(() => {
                          const d = formatRowDate(featuredFixture.date);
                          return `${d.dayName} ${d.day} ${d.month}`;
                        })()}
                      </div>
                      {featuredFixture.time && (
                        <p class="text-lg font-semibold text-gray-600 mt-1">{featuredFixture.time}</p>
                      )}
                    </div>

                    {/* Away Team */}
                    <div class="flex-1 text-center">
                      <div class="w-16 h-16 md:w-20 md:h-20 mx-auto mb-3 rounded-full flex items-center justify-center overflow-hidden" style={featuredFixture.awayTeam === CLUB_NAME ? '' : `background-color: ${getColor(featuredFixture.awayTeam)}`}>
                        {featuredFixture.awayTeam === CLUB_NAME ? (
                          <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="56" height="56" loading="lazy" class="w-14 h-14 md:w-16 md:h-16 object-contain" />
                        ) : (
                          <span class="text-white font-bold text-lg md:text-xl">{featuredFixture.awayTeam.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <p class="font-bold text-gray-900 text-sm md:text-base">{featuredFixture.awayTeam}</p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* Remaining Fixtures — Compact Rows */}
            {remainingFixtures.length > 0 && (
              <div class="bg-white rounded-lg shadow-sm border border-gray-100 divide-y divide-gray-100">
                {remainingFixtures.map((fixture) => {
                  const d = formatRowDate(fixture.date);
                  return (
                    <div class="fixture-item flex flex-col md:flex-row md:items-center gap-2 md:gap-4 px-4 py-4 md:px-6 hover:bg-gray-50 transition-colors" data-team={fixture.team}>
                      {/* Date & Meta */}
                      <div class="md:w-48 flex-shrink-0">
                        <p class="font-bold text-gray-900 text-sm">{d.dayName} {d.day} {d.month} {d.year}</p>
                        <p class="text-xs text-gray-500 truncate">{fixture.competition} &middot; {fixture.venue}</p>
                      </div>

                      {/* Matchup */}
                      <div class="flex-1 flex items-center gap-3 justify-center md:justify-start">
                        {/* Home */}
                        <div class="flex items-center gap-2 flex-1 justify-end md:justify-end">
                          <span class="font-semibold text-gray-900 text-sm text-right">{fixture.homeTeam}</span>
                          <div class="w-7 h-7 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0" style={fixture.homeTeam === CLUB_NAME ? '' : `background-color: ${getColor(fixture.homeTeam)}`}>
                            {fixture.homeTeam === CLUB_NAME ? (
                              <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="22" height="22" loading="lazy" class="w-[22px] h-[22px] object-contain" />
                            ) : (
                              <span class="text-white font-bold text-[10px]">{fixture.homeTeam.substring(0, 2).toUpperCase()}</span>
                            )}
                          </div>
                        </div>

                        {/* V */}
                        <span class="text-xs font-bold text-gray-400 flex-shrink-0 w-6 text-center">V</span>

                        {/* Away */}
                        <div class="flex items-center gap-2 flex-1">
                          <div class="w-7 h-7 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0" style={fixture.awayTeam === CLUB_NAME ? '' : `background-color: ${getColor(fixture.awayTeam)}`}>
                            {fixture.awayTeam === CLUB_NAME ? (
                              <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="22" height="22" loading="lazy" class="w-[22px] h-[22px] object-contain" />
                            ) : (
                              <span class="text-white font-bold text-[10px]">{fixture.awayTeam.substring(0, 2).toUpperCase()}</span>
                            )}
                          </div>
                          <span class="font-semibold text-gray-900 text-sm">{fixture.awayTeam}</span>
                        </div>
                      </div>

                      {/* Time */}
                      {fixture.time && (
                        <div class="md:w-20 flex-shrink-0 text-right">
                          <span class="text-sm font-semibold text-shamrock-700">{fixture.time}</span>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        ) : (
          <div class="text-center py-10">
            <div class="w-16 h-16 mx-auto mb-4 bg-gray-200 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">No Upcoming Fixtures</h3>
            <p class="text-gray-500 mb-4">Follow us on social media for schedule updates.</p>
            <a href="/updates" class="inline-flex items-center gap-2 px-5 py-2 bg-shamrock-700 text-white text-sm font-bold uppercase tracking-wide hover:bg-shamrock-600 transition-colors rounded-full">
              Stay Connected
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        )}

        <noscript>
          <style>.fixture-item { display: flex !important; }</style>
        </noscript>

        <p class="mt-6 text-center text-xs text-gray-400">
          Last updated: {new Date(fixturesData.lastUpdated).toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          })}
        </p>
      </div>

      <!-- ==================== RESULTS PANEL ==================== -->
      <div id="panel-results" role="tabpanel" aria-labelledby="tab-results" class="hidden">

        <!-- Result Filters -->
        <div class="mb-6 space-y-3">
          <div class="flex flex-wrap gap-2" id="year-filter">
            <button
              class="year-btn active px-4 py-1.5 rounded-full text-sm font-semibold transition-colors bg-shamrock-700 text-white"
              data-year="all"
            >
              All Years
            </button>
            {years.map((year) => (
              <button
                class="year-btn px-4 py-1.5 rounded-full text-sm font-semibold transition-colors bg-white text-gray-600 hover:bg-gray-100 border border-gray-200"
                data-year={year}
              >
                {year}
              </button>
            ))}
          </div>

          {resultTeams.length > 1 && (
            <div class="flex flex-wrap gap-2" id="team-filter">
              <button
                class="team-btn active px-4 py-1.5 rounded-full text-sm font-semibold transition-colors bg-shamrock-700 text-white"
                data-team="all"
              >
                All Teams
              </button>
              {resultTeams.map((team) => (
                <button
                  class="team-btn px-4 py-1.5 rounded-full text-sm font-semibold transition-colors bg-white text-gray-600 hover:bg-gray-100 border border-gray-200"
                  data-team={team}
                >
                  {team}
                </button>
              ))}
            </div>
          )}
        </div>

        {sortedResults.length > 0 ? (
          <div id="results-container">
            {/* Featured Latest Result */}
            {featuredResult && (
              <div class="result-item bg-white rounded-lg shadow-sm border border-gray-100 p-6 md:p-8 mb-6" data-team={featuredResult.team} data-year={featuredResult.year} data-outcome={featuredResult.outcome}>
                <div class="text-center">
                  <div class="flex items-center justify-center gap-3 mb-4">
                    <span class={`inline-block w-7 h-7 rounded-full text-white text-xs font-bold flex items-center justify-center ${outcomeColors[featuredResult.outcome]}`} aria-label={OUTCOME_ARIA_LABELS[featuredResult.outcome]}>
                      {outcomeLabels[featuredResult.outcome]}
                    </span>
                    <span class="text-sm text-gray-500">
                      {featuredResult.competition} &middot; {featuredResult.round}
                    </span>
                  </div>

                  <p class="text-xs text-gray-400 mb-5">
                    {formatRowDate(featuredResult.date).full} &middot; {featuredResult.venue}
                  </p>

                  {/* Teams & Score */}
                  <div class="flex items-center justify-center gap-6 md:gap-10">
                    {/* Home Team */}
                    <div class="flex-1 text-center">
                      <div class="w-16 h-16 md:w-20 md:h-20 mx-auto mb-3 rounded-full flex items-center justify-center overflow-hidden" style={featuredResult.homeTeam === CLUB_NAME ? '' : `background-color: ${getColor(featuredResult.homeTeam)}`}>
                        {featuredResult.homeTeam === CLUB_NAME ? (
                          <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="56" height="56" loading="lazy" class="w-14 h-14 md:w-16 md:h-16 object-contain" />
                        ) : (
                          <span class="text-white font-bold text-lg md:text-xl">{featuredResult.homeTeam.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <p class="font-bold text-gray-900 text-sm md:text-base"><span class="hidden md:inline">{featuredResult.homeTeam}</span><span class="md:hidden">{featuredResult.homeTeam === CLUB_NAME ? 'Brooklyn' : featuredResult.homeTeam.split(' ')[0]}</span></p>
                    </div>

                    {/* Score Center */}
                    <div class="flex-shrink-0 text-center">
                      <div class="flex items-center gap-3">
                        <span class={`text-3xl md:text-4xl font-bold ${featuredResult.homeTeam === CLUB_NAME ? 'text-shamrock-700' : 'text-gray-800'}`}>
                          {featuredResult.homeScore}
                        </span>
                        <span class="text-gray-300 text-2xl">-</span>
                        <span class={`text-3xl md:text-4xl font-bold ${featuredResult.awayTeam === CLUB_NAME ? 'text-shamrock-700' : 'text-gray-800'}`}>
                          {featuredResult.awayScore}
                        </span>
                      </div>
                    </div>

                    {/* Away Team */}
                    <div class="flex-1 text-center">
                      <div class="w-16 h-16 md:w-20 md:h-20 mx-auto mb-3 rounded-full flex items-center justify-center overflow-hidden" style={featuredResult.awayTeam === CLUB_NAME ? '' : `background-color: ${getColor(featuredResult.awayTeam)}`}>
                        {featuredResult.awayTeam === CLUB_NAME ? (
                          <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="56" height="56" loading="lazy" class="w-14 h-14 md:w-16 md:h-16 object-contain" />
                        ) : (
                          <span class="text-white font-bold text-lg md:text-xl">{featuredResult.awayTeam.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <p class="font-bold text-gray-900 text-sm md:text-base"><span class="hidden md:inline">{featuredResult.awayTeam}</span><span class="md:hidden">{featuredResult.awayTeam === CLUB_NAME ? 'Brooklyn' : featuredResult.awayTeam.split(' ')[0]}</span></p>
                    </div>
                  </div>

                  {/* Video Link */}
                  {featuredResult.videoUrl && (
                    <div class="mt-6">
                      <a
                        href={featuredResult.videoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gold-500 hover:bg-gold-600 text-gray-900 text-sm font-bold uppercase tracking-wide transition-colors"
                      >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                        Watch Full Match
                      </a>
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* Remaining Results — Compact Rows */}
            {remainingResults.length > 0 && (
              <div class="bg-white rounded-lg shadow-sm border border-gray-100 divide-y divide-gray-100">
                {remainingResults.map((result) => {
                  const d = formatRowDate(result.date);
                  return (
                    <div class="result-item flex flex-col md:flex-row md:items-center gap-2 md:gap-4 px-4 py-4 md:px-6 hover:bg-gray-50 transition-colors" data-team={result.team} data-year={result.year} data-outcome={result.outcome}>
                      {/* Date & Meta */}
                      <div class="md:w-48 flex-shrink-0">
                        <p class="font-bold text-gray-900 text-sm">{d.dayName} {d.day} {d.month} {d.year}</p>
                        <p class="text-xs text-gray-500 truncate" title={`${result.competition} · ${result.venue}`}>{result.competition} &middot; {result.venue}</p>
                      </div>

                      {/* Matchup with Score */}
                      <div class="flex-1 flex items-center gap-3 justify-center md:justify-start">
                        {/* Home */}
                        <div class="flex items-center gap-2 flex-1 justify-end">
                          <span class="font-semibold text-gray-900 text-sm text-right">{result.homeTeam}</span>
                          <div class="w-7 h-7 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0" style={result.homeTeam === CLUB_NAME ? '' : `background-color: ${getColor(result.homeTeam)}`}>
                            {result.homeTeam === CLUB_NAME ? (
                              <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="22" height="22" loading="lazy" class="w-[22px] h-[22px] object-contain" />
                            ) : (
                              <span class="text-white font-bold text-[10px]">{result.homeTeam.substring(0, 2).toUpperCase()}</span>
                            )}
                          </div>
                        </div>

                        {/* Score */}
                        <div class="flex items-center gap-1.5 flex-shrink-0">
                          <span class={`text-sm font-bold ${result.homeTeam === CLUB_NAME ? 'text-shamrock-700' : 'text-gray-700'}`}>{result.homeScore}</span>
                          <span class="text-xs text-gray-300">-</span>
                          <span class={`text-sm font-bold ${result.awayTeam === CLUB_NAME ? 'text-shamrock-700' : 'text-gray-700'}`}>{result.awayScore}</span>
                        </div>

                        {/* Away */}
                        <div class="flex items-center gap-2 flex-1">
                          <div class="w-7 h-7 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0" style={result.awayTeam === CLUB_NAME ? '' : `background-color: ${getColor(result.awayTeam)}`}>
                            {result.awayTeam === CLUB_NAME ? (
                              <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="22" height="22" loading="lazy" class="w-[22px] h-[22px] object-contain" />
                            ) : (
                              <span class="text-white font-bold text-[10px]">{result.awayTeam.substring(0, 2).toUpperCase()}</span>
                            )}
                          </div>
                          <span class="font-semibold text-gray-900 text-sm">{result.awayTeam}</span>
                        </div>
                      </div>

                      {/* Outcome Badge & Video */}
                      <div class="md:w-24 flex-shrink-0 flex items-center justify-end gap-2">
                        <span class={`w-6 h-6 rounded-full text-white text-[10px] font-bold inline-flex items-center justify-center ${outcomeColors[result.outcome]}`} aria-label={OUTCOME_ARIA_LABELS[result.outcome]}>
                          {outcomeLabels[result.outcome]}
                        </span>
                        {result.videoUrl && (
                          <a
                            href={result.videoUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gold-600 hover:text-gold-700 transition-colors"
                            title="Watch Full Match"
                          >
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M8 5v14l11-7z"/>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 bg-gray-200 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">No Results Yet</h3>
            <p class="text-gray-500">Results will appear here once matches are played.</p>
          </div>
        )}

        <!-- No Results Message (hidden by default, shown by JS filter) -->
        <div id="no-results-message" class="hidden text-center py-16">
          <div class="w-16 h-16 mx-auto mb-4 bg-gray-200 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">No Matches Found</h3>
          <p class="text-gray-500">No results match your selected filters.</p>
        </div>

        <noscript>
          <style>.result-item { display: flex !important; } #no-results-message { display: none !important; }</style>
        </noscript>

        <p class="mt-6 text-center text-xs text-gray-400">
          Last updated: {new Date(resultsData.lastUpdated).toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          })}
        </p>
      </div>

      <!-- ==================== TABLES PANEL ==================== -->
      <div id="panel-tables" role="tabpanel" aria-labelledby="tab-tables" class="hidden">
        <div class="space-y-8">
          {/* Senior Football Standings */}
          {seniorStandings.length > 0 && (
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
              <div class="bg-shamrock-900 px-4 py-3">
                <h3 class="text-sm font-bold text-white uppercase tracking-wide">NY Senior Football Championship</h3>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gray-200 bg-gray-50">
                      <th class="text-left pl-4 pr-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-8">#</th>
                      <th class="text-left px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide">Team</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">P</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">W</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">D</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">L</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-14 hidden sm:table-cell">F</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-14 hidden sm:table-cell">A</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-14">+/-</th>
                      <th class="text-center px-2 pr-4 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-12">Pts</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    {seniorStandings.map((s, i) => (
                      <tr class={`hover:bg-gray-50 transition-colors ${s.team === CLUB_NAME ? 'bg-shamrock-50' : ''}`}>
                        <td class="pl-4 pr-2 py-3 text-gray-400 font-semibold">{i + 1}</td>
                        <td class="px-2 py-3">
                          <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0" style={s.team === CLUB_NAME ? '' : `background-color: ${getColor(s.team)}`}>
                              {s.team === CLUB_NAME ? (
                                <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="22" height="22" loading="lazy" class="w-[22px] h-[22px] object-contain" />
                              ) : (
                                <span class="text-white font-bold text-[10px]">{s.team.substring(0, 2).toUpperCase()}</span>
                              )}
                            </div>
                            <span class={`font-semibold ${s.team === CLUB_NAME ? 'text-shamrock-700' : 'text-gray-900'}`}>{s.team}</span>
                          </div>
                        </td>
                        <td class="text-center px-2 py-3 font-semibold text-gray-700">{s.played}</td>
                        <td class="text-center px-2 py-3 text-gray-600">{s.wins}</td>
                        <td class="text-center px-2 py-3 text-gray-600">{s.draws}</td>
                        <td class="text-center px-2 py-3 text-gray-600">{s.losses}</td>
                        <td class="text-center px-2 py-3 text-gray-600 hidden sm:table-cell">{s.pointsFor}</td>
                        <td class="text-center px-2 py-3 text-gray-600 hidden sm:table-cell">{s.pointsAgainst}</td>
                        <td class="text-center px-2 py-3 font-semibold text-gray-700">{s.pointsDiff > 0 ? `+${s.pointsDiff}` : s.pointsDiff}</td>
                        <td class="text-center px-2 pr-4 py-3 font-bold text-shamrock-700">{s.totalPoints}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* Junior Football Standings */}
          {juniorStandings.length > 0 && (
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
              <div class="bg-shamrock-900 px-4 py-3">
                <h3 class="text-sm font-bold text-white uppercase tracking-wide">NY Junior Football Championship</h3>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gray-200 bg-gray-50">
                      <th class="text-left pl-4 pr-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-8">#</th>
                      <th class="text-left px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide">Team</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">P</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">W</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">D</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-10">L</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-14 hidden sm:table-cell">F</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-14 hidden sm:table-cell">A</th>
                      <th class="text-center px-2 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-14">+/-</th>
                      <th class="text-center px-2 pr-4 py-3 font-bold text-gray-500 uppercase text-xs tracking-wide w-12">Pts</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    {juniorStandings.map((s, i) => (
                      <tr class={`hover:bg-gray-50 transition-colors ${s.team === CLUB_NAME ? 'bg-shamrock-50' : ''}`}>
                        <td class="pl-4 pr-2 py-3 text-gray-400 font-semibold">{i + 1}</td>
                        <td class="px-2 py-3">
                          <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0" style={s.team === CLUB_NAME ? '' : `background-color: ${getColor(s.team)}`}>
                              {s.team === CLUB_NAME ? (
                                <img src="/images/crest_white_bg.png" alt={CLUB_NAME} width="22" height="22" loading="lazy" class="w-[22px] h-[22px] object-contain" />
                              ) : (
                                <span class="text-white font-bold text-[10px]">{s.team.substring(0, 2).toUpperCase()}</span>
                              )}
                            </div>
                            <span class={`font-semibold ${s.team === CLUB_NAME ? 'text-shamrock-700' : 'text-gray-900'}`}>{s.team}</span>
                          </div>
                        </td>
                        <td class="text-center px-2 py-3 font-semibold text-gray-700">{s.played}</td>
                        <td class="text-center px-2 py-3 text-gray-600">{s.wins}</td>
                        <td class="text-center px-2 py-3 text-gray-600">{s.draws}</td>
                        <td class="text-center px-2 py-3 text-gray-600">{s.losses}</td>
                        <td class="text-center px-2 py-3 text-gray-600 hidden sm:table-cell">{s.pointsFor}</td>
                        <td class="text-center px-2 py-3 text-gray-600 hidden sm:table-cell">{s.pointsAgainst}</td>
                        <td class="text-center px-2 py-3 font-semibold text-gray-700">{s.pointsDiff > 0 ? `+${s.pointsDiff}` : s.pointsDiff}</td>
                        <td class="text-center px-2 pr-4 py-3 font-bold text-shamrock-700">{s.totalPoints}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>

        <p class="mt-6 text-center text-xs text-gray-400">
          2 points for a win, 1 point for a draw. Sorted by points, then score difference.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // --- Tab switching ---
  const tabBtns = document.querySelectorAll('.tab-btn');
  const panels = ['fixtures', 'results', 'tables'];

  function switchTab(tab: string) {
    tabBtns.forEach(btn => {
      const isActive = btn.id === `tab-${tab}`;
      btn.classList.toggle('text-shamrock-700', isActive);
      btn.classList.toggle('text-gray-400', !isActive);
      btn.setAttribute('aria-selected', String(isActive));
    });

    panels.forEach(p => {
      document.getElementById(`panel-${p}`)?.classList.toggle('hidden', p !== tab);
    });

    // Update URL hash without scrolling
    const hash = tab === 'fixtures' ? '/matches' : `/matches#${tab}`;
    history.replaceState(null, '', hash);
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.id.replace('tab-', '');
      switchTab(tab);
    });
  });

  // Check hash on load
  const hash = window.location.hash.replace('#', '');
  if (panels.includes(hash)) {
    switchTab(hash);
  }

  // --- Fixtures filter ---
  const fixtureFilterBtns = document.querySelectorAll('.fixture-filter-btn');
  const fixtureItems = document.querySelectorAll('.fixture-item');

  fixtureFilterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      fixtureFilterBtns.forEach(b => {
        b.classList.remove('active', 'bg-shamrock-700', 'text-white');
        b.classList.add('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      });
      btn.classList.add('active', 'bg-shamrock-700', 'text-white');
      btn.classList.remove('bg-white', 'text-gray-600', 'border', 'border-gray-200');

      fixtureItems.forEach(item => {
        const team = item.getAttribute('data-team');
        if (filter === 'all' || team === filter) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // --- Results filters ---
  let activeYear = 'all';
  let activeTeam = 'all';

  const yearBtns = document.querySelectorAll('.year-btn');
  const teamBtns = document.querySelectorAll('.team-btn');
  const resultItems = document.querySelectorAll('.result-item');
  const resultsContainer = document.getElementById('results-container');
  const noResultsMessage = document.getElementById('no-results-message');

  function updateResultFilters() {
    let visibleCount = 0;
    resultItems.forEach(item => {
      const itemYear = item.getAttribute('data-year');
      const itemTeam = item.getAttribute('data-team');

      const yearMatch = activeYear === 'all' || itemYear === activeYear;
      const teamMatch = activeTeam === 'all' || itemTeam === activeTeam;

      if (yearMatch && teamMatch) {
        (item as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    if (noResultsMessage && resultsContainer) {
      if (visibleCount === 0) {
        noResultsMessage.classList.remove('hidden');
        resultsContainer.classList.add('hidden');
      } else {
        noResultsMessage.classList.add('hidden');
        resultsContainer.classList.remove('hidden');
      }
    }
  }

  function setActiveButton(buttons: NodeListOf<Element>, activeValue: string, dataAttr: string) {
    buttons.forEach(btn => {
      const btnValue = btn.getAttribute(dataAttr);
      if (btnValue === activeValue) {
        btn.classList.add('active', 'bg-shamrock-700', 'text-white');
        btn.classList.remove('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      } else {
        btn.classList.remove('active', 'bg-shamrock-700', 'text-white');
        btn.classList.add('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      }
    });
  }

  yearBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeYear = btn.getAttribute('data-year') || 'all';
      setActiveButton(yearBtns, activeYear, 'data-year');
      updateResultFilters();
    });
  });

  teamBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeTeam = btn.getAttribute('data-team') || 'all';
      setActiveButton(teamBtns, activeTeam, 'data-team');
      updateResultFilters();
    });
  });
</script>
