---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Updates" description="Latest news, match reports, and announcements from Brooklyn Shamrocks GAA, New York's oldest Gaelic Athletic Association club.">
  <Hero
    title="Club Updates"
    subtitle="Stay connected with the latest news, events, and announcements"
    size="small"
  />

  <section class="py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column - Info & Social -->
        <div class="lg:col-span-1 space-y-6">
          <!-- About Card -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-3">Stay Connected</h2>
            <p class="text-gray-600 text-sm mb-4">
              Follow our Facebook page for the latest match updates, club events, training announcements, and community news.
            </p>
            <a
              href="https://www.facebook.com/BrooklynShamrocks/"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-700"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              Visit Facebook Page
            </a>
          </div>

          <!-- Social Links -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Follow Us</h3>
            <div class="space-y-3">
              <a
                href="https://www.facebook.com/BrooklynShamrocks/"
                target="_blank"
                rel="noopener"
                class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors group"
              >
                <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-gray-900 group-hover:text-blue-600 transition-colors">Facebook</p>
                  <p class="text-sm text-gray-500">@BrooklynShamrocks</p>
                </div>
              </a>

              <a
                href="https://www.instagram.com/brooklynshamrocksgfc"
                target="_blank"
                rel="noopener"
                class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors group"
              >
                <div class="w-10 h-10 bg-gradient-to-br from-purple-600 via-pink-500 to-orange-400 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-gray-900 group-hover:text-pink-600 transition-colors">Instagram</p>
                  <p class="text-sm text-gray-500">@brooklynshamrocksgfc</p>
                </div>
              </a>

              <a
                href="https://x.com/bklynshamrocks"
                target="_blank"
                rel="noopener"
                class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors group"
              >
                <div class="w-10 h-10 bg-black rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-gray-900 group-hover:text-gray-700 transition-colors">X (Twitter)</p>
                  <p class="text-sm text-gray-500">@bklynshamrocks</p>
                </div>
              </a>
            </div>
          </div>

          <!-- Contact CTA -->
          <div class="bg-shamrock-50 rounded-xl p-6 border border-shamrock-100">
            <h3 class="text-lg font-bold text-gray-900 mb-2">Get Involved</h3>
            <p class="text-sm text-gray-600 mb-4">
              Interested in joining the club or learning more about Gaelic games?
            </p>
            <a href="/contact" class="btn btn-primary btn-sm w-full justify-center">
              Contact Us
            </a>
          </div>
        </div>

        <!-- Right Column - Facebook Feed -->
        <div class="lg:col-span-2">
          <div id="fb-root"></div>
          <div class="fb-feed-wrapper bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div
              class="fb-page"
              data-href="https://www.facebook.com/BrooklynShamrocks"
              data-tabs="timeline"
              data-width="500"
              data-height="900"
              data-small-header="false"
              data-adapt-container-width="true"
              data-hide-cover="false"
              data-show-facepile="true"
            >
              <blockquote cite="https://www.facebook.com/BrooklynShamrocks" class="fb-xfbml-parse-ignore">
                <a href="https://www.facebook.com/BrooklynShamrocks">Brooklyn Shamrocks GAA</a>
              </blockquote>
            </div>
          </div>

          <!-- Fallback -->
          <noscript>
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 text-center">
              <p class="text-gray-600 mb-4">Enable JavaScript to view our latest updates, or visit us directly:</p>
              <a
                href="https://www.facebook.com/BrooklynShamrocks"
                target="_blank"
                rel="noopener"
                class="btn btn-primary"
              >
                View on Facebook
              </a>
            </div>
          </noscript>
        </div>
      </div>
    </div>
  </section>

  <!-- Facebook SDK -->
  <script is:inline>
    (function(d, s, id) {
      var js, fjs = d.getElementsByTagName(s)[0];
      if (d.getElementById(id)) return;
      js = d.createElement(s); js.id = id;
      js.src = "https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v18.0";
      fjs.parentNode.insertBefore(js, fjs);
    }(document, 'script', 'facebook-jssdk'));
  </script>

  <style>
    .fb-feed-wrapper {
      min-height: 600px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 1rem;
    }

    @media (min-width: 640px) {
      .fb-feed-wrapper {
        padding: 1.5rem;
      }
    }

    .fb-page {
      width: 100% !important;
      max-width: 500px;
    }

    .fb-page > span,
    .fb-page iframe {
      width: 100% !important;
      min-width: 100% !important;
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }
  </style>
</BaseLayout>
