---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="py-24 md:py-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center justify-center w-24 h-24 bg-shamrock-100 rounded-full mb-8">
        <span class="text-5xl font-bold text-shamrock-700">4</span>
        <img src="/images/crest_white_bg.png" alt="" class="w-10 h-10 object-contain mx-1" />
        <span class="text-5xl font-bold text-shamrock-700">4</span>
      </div>

      <h1 class="text-4xl font-bold text-gray-900 mb-4">Page Not Found</h1>
      <p class="text-lg text-gray-600 mb-8">
        Looks like this one went wide. The page you're looking for doesn't exist or has been moved.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/matches" class="btn btn-outline">View Matches</a>
        <a href="/contact" class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
